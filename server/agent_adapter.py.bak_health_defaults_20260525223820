from __future__ import annotations

import copy
import json
import re
import sys
from pathlib import Path
from typing import Any


PROJECT_ROOT = Path(__file__).resolve().parents[1]

if str(PROJECT_ROOT) not in sys.path:
    sys.path.insert(0, str(PROJECT_ROOT))


VALID_ALGORITHMS = {
    "single",
    "random",
    "round_robin",
    "weighted_round_robin",
    "ip_hash",
    "least_connections",
}


DEFAULT_SECURITY = {
    "allowed_methods": ["GET", "POST", "PUT", "PATCH", "DELETE", "OPTIONS", "HEAD"],
    "blocked_paths": [],
    "rate_limit_per_minute": 120,
    "max_connections": 1000,
    "max_request_body_bytes": 1048576,
    "upstream_timeout_seconds": 30,
}


def _load_prompt_to_config():
    """
    Load your existing AI prompt-to-config function.

    This stays server-side because it may use OpenAI/LangChain/LangGraph.
    """
    try:
        from ai.ai_config import prompt_to_config

        return prompt_to_config
    except Exception:
        from ai_config import prompt_to_config

        return prompt_to_config


def _normalise_ai_result(result: Any) -> dict[str, Any]:
    """
    Convert AI result into a Python dict.
    """
    if isinstance(result, dict):
        return copy.deepcopy(result)

    if isinstance(result, str):
        return json.loads(result)

    if hasattr(result, "model_dump"):
        dumped = result.model_dump()
        if isinstance(dumped, dict):
            return dumped

    if hasattr(result, "dict"):
        dumped = result.dict()
        if isinstance(dumped, dict):
            return dumped

    raise ValueError(f"Unsupported AI planner output type: {type(result)}")


def _normalise_path(path: Any) -> str:
    text = str(path or "/").strip()

    if not text:
        return "/"

    if not text.startswith("/"):
        text = "/" + text

    text = re.sub(r"[^a-zA-Z0-9/_\-.]", "", text)

    if not text:
        return "/"

    if not text.startswith("/"):
        text = "/" + text

    if len(text) > 1:
        text = text.rstrip("/")

    return text


def _normalise_algorithm(value: Any, default: str = "round_robin") -> str:
    text = str(value or "").strip().lower()
    text = text.replace("-", "_").replace(" ", "_")

    aliases = {
        "rr": "round_robin",
        "roundrobin": "round_robin",
        "weighted": "weighted_round_robin",
        "weighted_rr": "weighted_round_robin",
        "weighted_roundrobin": "weighted_round_robin",
        "least_connection": "least_connections",
        "leastconnections": "least_connections",
        "least_conn": "least_connections",
        "iphash": "ip_hash",
        "hash": "ip_hash",
        "load_balance": "round_robin",
        "load_balancer": "round_robin",
    }

    text = aliases.get(text, text)

    if text in VALID_ALGORITHMS:
        return text

    return default


def _extract_route_algorithm_intent(prompt: str) -> dict[str, str]:
    """
    Extract simple per-route algorithm intent from the user prompt.

    Example:
    "create gateway with /api random across ..."
    returns:
    {"/api": "random"}
    """

    route_algorithms: dict[str, str] = {}

    route_matches = list(re.finditer(r"(/[a-zA-Z0-9_\-/.]*)", prompt))

    for index, match in enumerate(route_matches):
        path = _normalise_path(match.group(1))

        start = match.start()
        end = route_matches[index + 1].start() if index + 1 < len(route_matches) else len(prompt)

        clause = prompt[start:end].lower()
        clause = clause.replace("-", "_")

        algorithm: str | None = None

        if "weighted round robin" in clause or "weighted_round_robin" in clause:
            algorithm = "weighted_round_robin"
        elif (
            "least connections" in clause
            or "least connection" in clause
            or "least_connections" in clause
        ):
            algorithm = "least_connections"
        elif "ip hash" in clause or "ip_hash" in clause:
            algorithm = "ip_hash"
        elif "round robin" in clause or "round_robin" in clause:
            algorithm = "round_robin"
        elif "random" in clause:
            algorithm = "random"

        if algorithm:
            route_algorithms[path] = algorithm

    return route_algorithms


def _apply_prompt_algorithm_intent(
    config: dict[str, Any],
    prompt: str,
) -> dict[str, Any]:
    """
    Force final config to respect route algorithm stated in the prompt.

    This prevents repair/validator defaults from accidentally changing:
    random → round_robin
    ip_hash → round_robin
    least_connections → round_robin
    """

    intended_algorithms = _extract_route_algorithm_intent(prompt)

    if not intended_algorithms:
        return config

    routes = config.get("routes", [])

    if not isinstance(routes, list):
        return config

    for route in routes:
        if not isinstance(route, dict):
            continue

        path = _normalise_path(route.get("path", "/"))
        intended_algorithm = intended_algorithms.get(path)

        if intended_algorithm:
            route["balancing"] = intended_algorithm
            route.pop("load_balance", None)
            route.pop("algorithm", None)
            route.pop("lb_algorithm", None)

    return config


def _coerce_upstream(value: Any) -> Any:
    """
    Preserve either string upstreams or weighted upstream objects.
    """
    if isinstance(value, dict):
        upstream = (
            value.get("upstream")
            or value.get("address")
            or value.get("backend")
            or value.get("url")
            or value.get("target")
        )

        if not upstream:
            return value

        result: dict[str, Any] = {"upstream": str(upstream)}

        if "weight" in value:
            try:
                result["weight"] = int(value["weight"])
            except Exception:
                result["weight"] = value["weight"]

        return result

    return str(value)


def _extract_upstreams(route: dict[str, Any]) -> list[Any]:
    upstreams: list[Any] = []

    single_values = [
        route.get("upstream"),
        route.get("backend"),
        route.get("target"),
        route.get("address"),
    ]

    for value in single_values:
        if value:
            upstreams.append(_coerce_upstream(value))

    list_value = route.get("upstreams") or route.get("backends")

    if isinstance(list_value, list):
        for item in list_value:
            if item:
                upstreams.append(_coerce_upstream(item))

    return _dedupe_upstreams(upstreams)


def _dedupe_upstreams(upstreams: list[Any]) -> list[Any]:
    seen: set[str] = set()
    result: list[Any] = []

    for upstream in upstreams:
        key = json.dumps(upstream, sort_keys=True) if isinstance(upstream, dict) else str(upstream)

        if key in seen:
            continue

        seen.add(key)
        result.append(upstream)

    return result


def _basic_duplicate_route_repair(config: dict[str, Any]) -> dict[str, Any]:
    """
    Minimal fallback repair:
    merges duplicate same-path routes into one route with upstreams[].
    """

    routes = config.get("routes", [])

    if not isinstance(routes, list):
        return config

    merged: dict[str, dict[str, Any]] = {}

    for route in routes:
        if not isinstance(route, dict):
            continue

        path = _normalise_path(route.get("path", "/"))

        existing = merged.setdefault(
            path,
            {
                "path": path,
                "upstreams": [],
            },
        )

        balancing = (
            route.get("balancing")
            or route.get("load_balance")
            or route.get("algorithm")
            or route.get("lb_algorithm")
        )

        if balancing:
            existing["balancing"] = _normalise_algorithm(balancing)

        for upstream in _extract_upstreams(route):
            existing["upstreams"].append(upstream)

    final_routes: list[dict[str, Any]] = []

    for route in merged.values():
        route["upstreams"] = _dedupe_upstreams(route.get("upstreams", []))

        if len(route["upstreams"]) <= 1:
            route["balancing"] = "single"
            if route["upstreams"]:
                route["upstream"] = route["upstreams"][0]
        else:
            route["balancing"] = _normalise_algorithm(route.get("balancing"), "round_robin")
            route.pop("upstream", None)

        final_routes.append(route)

    config["routes"] = final_routes
    return config


def _repair_config(config: dict[str, Any]) -> dict[str, Any]:
    """
    Try your existing repair agent first.
    If function names differ or fail, fallback to local duplicate route repair.
    """

    repair_candidates = [
        ("agents.config_repair_agent", "repair_config"),
        ("agents.config_repair_agent", "repair_gateway_config"),
        ("agents.config_repair_agent", "run_config_repair_agent"),
        ("agents.config_repair_agent", "repair"),
    ]

    for module_name, function_name in repair_candidates:
        try:
            module = __import__(module_name, fromlist=[function_name])
            fn = getattr(module, function_name)
            repaired = fn(copy.deepcopy(config))

            if isinstance(repaired, dict):
                if "config" in repaired and isinstance(repaired["config"], dict):
                    return repaired["config"]
                return repaired

            if isinstance(repaired, str):
                return json.loads(repaired)

            if hasattr(repaired, "model_dump"):
                dumped = repaired.model_dump()
                if isinstance(dumped, dict):
                    if "config" in dumped and isinstance(dumped["config"], dict):
                        return dumped["config"]
                    return dumped

        except Exception:
            continue

    return _basic_duplicate_route_repair(config)


def _validate_config(config: dict[str, Any]) -> dict[str, Any]:
    """
    Run your existing validator if available.

    Validators may return:
    - None
    - validated config
    - report dict
    - raise exception

    This adapter keeps the API alive and returns the config unless a validator
    returns a better config object.
    """

    validator_candidates = [
        ("core.validator", "validate_config"),
        ("core.validator", "validate_gateway_config"),
        ("core.validator", "validate"),
    ]

    for module_name, function_name in validator_candidates:
        try:
            module = __import__(module_name, fromlist=[function_name])
            fn = getattr(module, function_name)
            result = fn(copy.deepcopy(config))

            if isinstance(result, dict):
                if "routes" in result:
                    return result

                if "config" in result and isinstance(result["config"], dict):
                    return result["config"]

            return config

        except Exception:
            continue

    return config


def _apply_security_defaults(config: dict[str, Any]) -> dict[str, Any]:
    security = config.get("security")

    if not isinstance(security, dict):
        security = {}

    for key, value in DEFAULT_SECURITY.items():
        security.setdefault(key, copy.deepcopy(value))

    config["security"] = security
    return config


def _final_route_normalise(config: dict[str, Any]) -> dict[str, Any]:
    """
    Final API-facing route cleanup.

    Ensures:
    - duplicate paths are merged
    - balancing is canonical
    - load_balance/algorithm aliases are removed
    - multiple backends use upstreams[]
    - single backend keeps upstream
    """

    routes = config.get("routes", [])

    if not isinstance(routes, list):
        config["routes"] = []
        return config

    merged: dict[str, dict[str, Any]] = {}

    for route in routes:
        if not isinstance(route, dict):
            continue

        path = _normalise_path(route.get("path", "/"))

        existing = merged.setdefault(
            path,
            {
                "path": path,
                "upstreams": [],
            },
        )

        route_algorithm = (
            route.get("balancing")
            or route.get("load_balance")
            or route.get("algorithm")
            or route.get("lb_algorithm")
        )

        if route_algorithm:
            existing["balancing"] = _normalise_algorithm(route_algorithm)

        for upstream in _extract_upstreams(route):
            existing["upstreams"].append(upstream)

        route_type = route.get("type")
        if route_type:
            existing["type"] = route_type

        if route.get("static_dir"):
            existing["static_dir"] = route.get("static_dir")

        if route.get("index_file"):
            existing["index_file"] = route.get("index_file")

    final_routes: list[dict[str, Any]] = []

    for route in merged.values():
        route["upstreams"] = _dedupe_upstreams(route.get("upstreams", []))

        route.pop("load_balance", None)
        route.pop("algorithm", None)
        route.pop("lb_algorithm", None)
        route.pop("backend", None)
        route.pop("backends", None)

        route_type = route.get("type")

        if route_type == "static":
            route["balancing"] = "single"
            final_routes.append(route)
            continue

        if len(route["upstreams"]) == 0:
            route.setdefault("balancing", "single")
            final_routes.append(route)
            continue

        if len(route["upstreams"]) == 1:
            route["balancing"] = "single"
            route["upstream"] = route["upstreams"][0]
            final_routes.append(route)
            continue

        route.pop("upstream", None)
        route["balancing"] = _normalise_algorithm(route.get("balancing"), "round_robin")
        final_routes.append(route)

    config["routes"] = final_routes
    return config


def generate_gateway_plan(
    prompt: str,
    runtime: str = "docker_host",
    strategy: str = "bluegreen",
    verify: str = "full",
) -> dict[str, Any]:
    """
    Server-side AI planning adapter.

    Final flow:
    prompt
      → prompt_to_config
      → repair duplicate routes
      → preserve prompt algorithm intent
      → validate
      → preserve prompt algorithm intent again
      → final route cleanup
      → security defaults
      → return safe config JSON
    """

    prompt_to_config = _load_prompt_to_config()

    raw_config = prompt_to_config(prompt)
    config = _normalise_ai_result(raw_config)

    config.setdefault("port", 8090)
    config["runtime"] = runtime
    config["strategy"] = strategy
    config["verify"] = verify

    config = _repair_config(config)
    config = _apply_prompt_algorithm_intent(config, prompt)

    config = _validate_config(config)
    config = _apply_prompt_algorithm_intent(config, prompt)

    config = _final_route_normalise(config)
    config = _apply_prompt_algorithm_intent(config, prompt)

    config = _apply_security_defaults(config)

    config["runtime"] = runtime
    config["strategy"] = strategy
    config["verify"] = verify

    return config