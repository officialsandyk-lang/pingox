from __future__ import annotations

import argparse
import json
import sqlite3
import subprocess
import sys
from datetime import UTC, datetime
from pathlib import Path
from typing import Any


PROJECT_ROOT = Path(__file__).resolve().parents[1]
CONFIG_PATH = PROJECT_ROOT / "generated-pingora-proxy" / "config.json"
DB_PATH = PROJECT_ROOT / "data" / "reliability_reports.sqlite3"


def utc_now() -> str:
    return datetime.now(UTC).isoformat()


def load_config() -> dict[str, Any]:
    if not CONFIG_PATH.exists():
        raise RuntimeError(f"Config not found: {CONFIG_PATH}")

    return json.loads(CONFIG_PATH.read_text(encoding="utf-8"))


def docker_ps_names() -> list[str]:
    result = subprocess.run(
        ["docker", "ps", "--format", "{{.Names}}"],
        cwd=str(PROJECT_ROOT),
        text=True,
        capture_output=True,
        check=False,
    )

    return [line.strip() for line in result.stdout.splitlines() if line.strip()]


def restart_demo_backends() -> None:
    script = PROJECT_ROOT / "scripts" / "demo_backends.py"

    if script.exists():
        subprocess.run(
            [sys.executable, str(script), "restart", str(CONFIG_PATH)],
            cwd=str(PROJECT_ROOT),
            text=True,
            check=False,
        )


def ensure_docker_healing_table() -> None:
    DB_PATH.parent.mkdir(parents=True, exist_ok=True)

    with sqlite3.connect(DB_PATH) as conn:
        conn.execute(
            """
            CREATE TABLE IF NOT EXISTS docker_self_healing_runs (
                id INTEGER PRIMARY KEY AUTOINCREMENT,
                created_at_utc TEXT NOT NULL,
                runtime TEXT,
                strategy TEXT,
                root_cause TEXT,
                action TEXT,
                success INTEGER,
                details_json TEXT
            )
            """
        )
        conn.commit()


def store_docker_healing_run(
    *,
    runtime: str,
    strategy: str,
    root_cause: str,
    action: str,
    success: bool,
    details: dict[str, Any],
) -> None:
    ensure_docker_healing_table()

    now = utc_now()
    details_json = json.dumps(details, indent=2, default=str)

    with sqlite3.connect(DB_PATH) as conn:
        conn.execute(
            """
            INSERT INTO docker_self_healing_runs (
                created_at_utc,
                runtime,
                strategy,
                root_cause,
                action,
                success,
                details_json
            )
            VALUES (?, ?, ?, ?, ?, ?, ?)
            """,
            (
                now,
                runtime,
                strategy,
                root_cause,
                action,
                1 if success else 0,
                details_json,
            ),
        )
        conn.commit()


def _legacy_self_healing_table_exists(conn: sqlite3.Connection) -> bool:
    row = conn.execute(
        """
        SELECT name
        FROM sqlite_master
        WHERE type='table' AND name='self_healing_runs'
        """
    ).fetchone()

    return row is not None


def _value_for_legacy_column(
    column: str,
    *,
    now: str,
    runtime: str,
    strategy: str,
    root_cause: str,
    action: str,
    success: bool,
    details_json: str,
) -> Any:
    mapping: dict[str, Any] = {
        "created_at": now,
        "created_at_utc": now,
        "timestamp": now,
        "runtime": runtime,
        "runtime_mode": runtime,
        "strategy": strategy,
        "deployment_strategy": strategy,
        "root_cause": root_cause,
        "action": action,
        "repair_action": action,
        "success": 1 if success else 0,
        "healed": 1 if success else 0,
        "details_json": details_json,
        "result_json": details_json,
        "metadata_json": details_json,
        "verification_json": details_json,
    }

    if column in mapping:
        return mapping[column]

    if column.endswith("_json"):
        return details_json

    if column.startswith("is_") or column in {"ok", "passed"}:
        return 1 if success else 0

    return ""


def store_legacy_self_healing_run_best_effort(
    *,
    runtime: str,
    strategy: str,
    root_cause: str,
    action: str,
    success: bool,
    details: dict[str, Any],
) -> None:
    """
    Best-effort compatibility write for old local self_healing_runs schemas.

    This must never break Docker healing.
    """

    now = utc_now()
    details_json = json.dumps(details, indent=2, default=str)

    try:
        with sqlite3.connect(DB_PATH) as conn:
            if not _legacy_self_healing_table_exists(conn):
                return

            info = conn.execute("PRAGMA table_info(self_healing_runs)").fetchall()

            insert_columns: list[str] = []
            values: list[Any] = []

            for row in info:
                # PRAGMA columns:
                # cid, name, type, notnull, dflt_value, pk
                name = row[1]
                pk = bool(row[5])

                if pk and name == "id":
                    continue

                insert_columns.append(name)
                values.append(
                    _value_for_legacy_column(
                        name,
                        now=now,
                        runtime=runtime,
                        strategy=strategy,
                        root_cause=root_cause,
                        action=action,
                        success=success,
                        details_json=details_json,
                    )
                )

            if not insert_columns:
                return

            placeholders = ", ".join("?" for _ in insert_columns)
            column_sql = ", ".join(insert_columns)

            conn.execute(
                f"""
                INSERT INTO self_healing_runs ({column_sql})
                VALUES ({placeholders})
                """,
                tuple(values),
            )
            conn.commit()

    except Exception as exc:
        print(f"⚠️ Legacy self_healing_runs write skipped: {exc}")


def store_healing_run(
    *,
    runtime: str,
    strategy: str,
    root_cause: str,
    action: str,
    success: bool,
    details: dict[str, Any],
) -> None:
    """
    Store Docker healing result.

    Important:
    - Always writes to docker_self_healing_runs.
    - Tries old self_healing_runs only best-effort.
    - Never lets legacy SQLite schema issues fail a successful healing run.
    """

    store_docker_healing_run(
        runtime=runtime,
        strategy=strategy,
        root_cause=root_cause,
        action=action,
        success=success,
        details=details,
    )

    store_legacy_self_healing_run_best_effort(
        runtime=runtime,
        strategy=strategy,
        root_cause=root_cause,
        action=action,
        success=success,
        details=details,
    )




def run_best_effort(command: list[str], timeout: int = 30) -> str:
    try:
        result = subprocess.run(
            command,
            cwd=str(PROJECT_ROOT),
            text=True,
            stdout=subprocess.PIPE,
            stderr=subprocess.STDOUT,
            timeout=timeout,
            check=False,
        )
        return result.stdout or ""
    except Exception as exc:
        return f"Failed to run {' '.join(command)}: {exc}"


def collect_docker_healing_evidence() -> dict[str, Any]:
    """
    Docker equivalent of local log-based healing evidence.

    Collects:
    - docker ps
    - Docker blue/green compose ps
    - edge/blue/green logs
    - current prod_check-style container state
    """

    evidence = {
        "docker_ps": run_best_effort(["docker", "ps", "-a"], timeout=20),
        "docker_images": run_best_effort(["docker", "images"], timeout=20),
        "docker_networks": run_best_effort(["docker", "network", "ls"], timeout=20),
        "edge_logs": run_best_effort(["docker", "logs", "--tail", "200", "ai-pingora-gateway-edge"], timeout=30),
        "blue_logs": run_best_effort(["docker", "logs", "--tail", "200", "ai-pingora-gateway-blue"], timeout=30),
        "green_logs": run_best_effort(["docker", "logs", "--tail", "200", "ai-pingora-gateway-green"], timeout=30),
    }

    compose_file = PROJECT_ROOT / "docker-bluegreen" / "docker-compose.yml"

    if compose_file.exists():
        evidence["compose_ps"] = run_best_effort(
            ["docker", "compose", "-f", str(compose_file), "ps", "-a"],
            timeout=20,
        )
        evidence["compose_logs"] = run_best_effort(
            ["docker", "compose", "-f", str(compose_file), "logs", "--tail", "200"],
            timeout=40,
        )

    return evidence


def classify_docker_healing_root_cause(evidence: dict[str, Any]) -> str:
    text = json.dumps(evidence, default=str).lower()

    if "ai-pingora-gateway-edge" not in text:
        return "docker_bluegreen_stack_not_running"

    if "cannot connect to the docker daemon" in text or "docker: command not found" in text:
        return "docker_unavailable"

    if "exited" in text or "restart" in text or "error" in text:
        return "docker_container_unhealthy_or_exited"

    if "host.docker.internal" in text and (
        "connection refused" in text
        or "name or service not known" in text
        or "failed to lookup" in text
    ):
        return "docker_upstream_connectivity_failure"

    if "502" in text or "bad gateway" in text:
        return "docker_gateway_bad_gateway_upstream_failure"

    return "docker_bluegreen_runtime_or_verification_failure"


def heal_docker_bluegreen(*, verify_level: str = "full") -> dict[str, Any]:
    from core.environment_deployer import (
        apply_profiles,
        create_backup,
        start_docker_bluegreen,
        verify_deployment,
        write_project_from_config,
    )

    config = load_config()

    runtime = "docker_host"
    strategy = "bluegreen"

    before_containers = docker_ps_names()

    required = {
        "ai-pingora-gateway-blue",
        "ai-pingora-gateway-green",
        "ai-pingora-gateway-edge",
    }

    missing = sorted(required - set(before_containers))

    evidence = collect_docker_healing_evidence()
    root_cause = classify_docker_healing_root_cause(evidence)

    if missing:
        root_cause = "docker_bluegreen_stack_not_running"

    print("")
    print("🩺 Docker blue-green self-healing")
    print(f"Runtime: {runtime}")
    print(f"Strategy: {strategy}")
    print(f"Root cause: {root_cause}")

    backup = create_backup(reason="before_docker_self_healing")

    fixed = apply_profiles(
        config,
        runtime_mode=runtime,
        strategy=strategy,
    )

    write_project_from_config(fixed)
    restart_demo_backends()

    deploy_result = start_docker_bluegreen(fixed)

    verification = verify_deployment(
        fixed,
        live_url=deploy_result["live_url"],
        level=verify_level,
    )

    after_containers = docker_ps_names()
    success = bool(verification.get("success"))

    result = {
        "success": success,
        "healed": success,
        "runtime": runtime,
        "strategy": strategy,
        "root_cause": root_cause,
        "action": "redeploy_docker_bluegreen_then_verify",
        "backup": str(backup) if backup else None,
        "before_containers": before_containers,
        "missing_before": missing,
        "healing_evidence": evidence,
        "after_containers": after_containers,
        "deployment": deploy_result,
        "verification": verification,
    }

    store_healing_run(
        runtime=runtime,
        strategy=strategy,
        root_cause=root_cause,
        action="redeploy_docker_bluegreen_then_verify",
        success=success,
        details=result,
    )

    print("")
    print("🧾 Docker self-healing result")
    print(json.dumps(result, indent=2, default=str)[:12000])

    return result


def main() -> int:
    parser = argparse.ArgumentParser(description="Docker blue-green self-healing runner.")
    parser.add_argument(
        "--verify",
        choices=["smoke", "algorithm", "crud", "stress", "full"],
        default="full",
    )

    args = parser.parse_args()

    result = heal_docker_bluegreen(verify_level=args.verify)

    return 0 if result.get("success") else 1


if __name__ == "__main__":
    raise SystemExit(main())
