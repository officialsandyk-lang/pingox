from __future__ import annotations

import argparse
import json
import sqlite3
import subprocess
import sys
from datetime import UTC, datetime
from pathlib import Path
from typing import Any


PROJECT_ROOT = Path(__file__).resolve().parents[1]
CONFIG_PATH = PROJECT_ROOT / "generated-pingora-proxy" / "config.json"
DB_PATH = PROJECT_ROOT / "data" / "reliability_reports.sqlite3"


def utc_now() -> str:
    return datetime.now(UTC).isoformat()


def load_config() -> dict[str, Any]:
    if not CONFIG_PATH.exists():
        raise RuntimeError(f"Config not found: {CONFIG_PATH}")

    return json.loads(CONFIG_PATH.read_text(encoding="utf-8"))


def docker_ps_names() -> list[str]:
    result = subprocess.run(
        ["docker", "ps", "--format", "{{.Names}}"],
        cwd=str(PROJECT_ROOT),
        text=True,
        capture_output=True,
        check=False,
    )

    return [line.strip() for line in result.stdout.splitlines() if line.strip()]


def restart_demo_backends() -> None:
    script = PROJECT_ROOT / "scripts" / "demo_backends.py"

    if script.exists():
        subprocess.run(
            [sys.executable, str(script), "restart", str(CONFIG_PATH)],
            cwd=str(PROJECT_ROOT),
            text=True,
            check=False,
        )


def ensure_healing_table() -> None:
    """
    Create or migrate self_healing_runs safely.

    Older local self-healing code may have created this table with different
    columns such as created_at_utc instead of created_at. This migration keeps
    both names compatible.
    """

    DB_PATH.parent.mkdir(parents=True, exist_ok=True)

    required_columns = {
        "created_at": "TEXT",
        "created_at_utc": "TEXT",
        "runtime": "TEXT",
        "strategy": "TEXT",
        "root_cause": "TEXT",
        "action": "TEXT",
        "success": "INTEGER",
        "details_json": "TEXT",
    }

    with sqlite3.connect(DB_PATH) as conn:
        conn.execute(
            """
            CREATE TABLE IF NOT EXISTS self_healing_runs (
                id INTEGER PRIMARY KEY AUTOINCREMENT,
                created_at TEXT,
                created_at_utc TEXT,
                runtime TEXT,
                strategy TEXT,
                root_cause TEXT,
                action TEXT,
                success INTEGER,
                details_json TEXT
            )
            """
        )

        existing = {
            row[1]
            for row in conn.execute("PRAGMA table_info(self_healing_runs)").fetchall()
        }

        for column, column_type in required_columns.items():
            if column not in existing:
                conn.execute(
                    f"ALTER TABLE self_healing_runs ADD COLUMN {column} {column_type}"
                )

        conn.commit()


def _self_healing_columns() -> set[str]:
    ensure_healing_table()

    with sqlite3.connect(DB_PATH) as conn:
        return {
            row[1]
            for row in conn.execute("PRAGMA table_info(self_healing_runs)").fetchall()
        }


def store_healing_run(
    *,
    runtime: str,
    strategy: str,
    root_cause: str,
    action: str,
    success: bool,
    details: dict[str, Any],
) -> None:
    """
    Store healing result using whatever timestamp columns exist.

    Supports both:
    - created_at
    - created_at_utc

    This avoids crashes when older SQLite schemas already exist.
    """

    columns = _self_healing_columns()
    now = utc_now()

    values = {
        "created_at": now,
        "created_at_utc": now,
        "runtime": runtime,
        "strategy": strategy,
        "root_cause": root_cause,
        "action": action,
        "success": 1 if success else 0,
        "details_json": json.dumps(details, indent=2, default=str),
    }

    insert_columns = [
        column
        for column in [
            "created_at",
            "created_at_utc",
            "runtime",
            "strategy",
            "root_cause",
            "action",
            "success",
            "details_json",
        ]
        if column in columns
    ]

    placeholders = ", ".join("?" for _ in insert_columns)
    column_sql = ", ".join(insert_columns)

    with sqlite3.connect(DB_PATH) as conn:
        conn.execute(
            f"""
            INSERT INTO self_healing_runs ({column_sql})
            VALUES ({placeholders})
            """,
            tuple(values[column] for column in insert_columns),
        )
        conn.commit()


def heal_docker_bluegreen(*, verify_level: str = "full") -> dict[str, Any]:
    from core.environment_deployer import (
        apply_profiles,
        create_backup,
        start_docker_bluegreen,
        verify_deployment,
        write_project_from_config,
    )

    config = load_config()

    runtime = config.get("runtime_mode") or config.get("runtime") or "docker_host"
    strategy = config.get("strategy") or config.get("deployment_strategy") or "bluegreen"

    before_containers = docker_ps_names()

    required = {
        "ai-pingora-gateway-blue",
        "ai-pingora-gateway-green",
        "ai-pingora-gateway-edge",
    }

    missing = sorted(required - set(before_containers))

    if missing:
        root_cause = "docker_bluegreen_stack_not_running"
    else:
        root_cause = "docker_bluegreen_runtime_or_verification_failure"

    print("")
    print("🩺 Docker blue-green self-healing")
    print(f"Runtime: {runtime}")
    print(f"Strategy: {strategy}")
    print(f"Root cause: {root_cause}")

    backup = create_backup(reason="before_docker_self_healing")

    fixed = apply_profiles(
        config,
        runtime_mode="docker_host",
        strategy="bluegreen",
    )

    write_project_from_config(fixed)
    restart_demo_backends()

    deploy_result = start_docker_bluegreen(fixed)

    verification = verify_deployment(
        fixed,
        live_url=deploy_result["live_url"],
        level=verify_level,
    )

    after_containers = docker_ps_names()

    success = bool(verification.get("success"))

    result = {
        "success": success,
        "healed": success,
        "runtime": "docker_host",
        "strategy": "bluegreen",
        "root_cause": root_cause,
        "action": "redeploy_docker_bluegreen_then_verify",
        "backup": str(backup) if backup else None,
        "before_containers": before_containers,
        "missing_before": missing,
        "after_containers": after_containers,
        "deployment": deploy_result,
        "verification": verification,
    }

    store_healing_run(
        runtime="docker_host",
        strategy="bluegreen",
        root_cause=root_cause,
        action="redeploy_docker_bluegreen_then_verify",
        success=success,
        details=result,
    )

    print("")
    print("🧾 Docker self-healing result")
    print(json.dumps(result, indent=2, default=str)[:12000])

    return result


def main() -> int:
    parser = argparse.ArgumentParser(description="Docker blue-green self-healing runner.")
    parser.add_argument(
        "--verify",
        choices=["smoke", "algorithm", "crud", "stress", "full"],
        default="full",
    )

    args = parser.parse_args()

    result = heal_docker_bluegreen(verify_level=args.verify)

    return 0 if result.get("success") else 1


if __name__ == "__main__":
    raise SystemExit(main())
