CRUD_METHODS = ["GET", "POST", "PUT", "PATCH", "DELETE", "OPTIONS", "HEAD"]
CRUD_BODY_METHODS = {"POST", "PUT", "PATCH", "DELETE"}
GATEWAY_REJECTION_STATUSES = {403, 405, 413, 414, 429, 500, 501, 502, 503, 504}


def _request_method(
    url: str,
    *,
    method: str,
    body: bytes | None = None,
    headers: dict[str, str] | None = None,
    timeout: int = 10,
) -> tuple[int | None, str, dict[str, str]]:
    try:
        request = urllib.request.Request(
            url,
            data=body,
            method=method,
            headers=headers or {},
        )

        with urllib.request.urlopen(request, timeout=timeout) as response:
            response_body = response.read().decode("utf-8", errors="replace")
            return int(response.status), response_body, dict(response.headers)
    except urllib.error.HTTPError as exc:
        try:
            response_body = exc.read().decode("utf-8", errors="replace")
        except Exception:
            response_body = str(exc)

        return int(exc.code), response_body, dict(exc.headers)
    except Exception as exc:
        return None, str(exc), {}


def _crud_probe_path(route_path: str) -> str:
    route_path = _normalize_path(route_path)

    if route_path == "/":
        return "/__gateway_crud_probe__/resource/123"

    return route_path.rstrip("/") + "/__gateway_crud_probe__/resource/123"


def _is_gateway_rejection(status: int | None) -> bool:
    if status is None:
        return True

    return status in GATEWAY_REJECTION_STATUSES


def _has_backend_evidence(body: str) -> bool:
    text = body or ""

    return (
        "Demo Backend" in text
        or "DemoBackend" in text
        or "backend" in text.lower()
        or "method" in text.lower()
        or "path" in text.lower()
    )


def _check_crud_methods_for_route(
    route: dict[str, Any],
    live_url: str,
    *,
    strict_body_echo: bool = False,
) -> list[dict[str, Any]]:
    checks: list[dict[str, Any]] = []

    if _is_static_route(route):
        return checks

    route_path = _normalize_path(route.get("path") or "/")

    if route_path == "/":
        return checks

    probe_path = _crud_probe_path(route_path)
    url = _route_url(live_url, probe_path)

    for method in CRUD_METHODS:
        marker = f"crud-probe-{route_path.strip('/').replace('/', '-')}-{method.lower()}"

        body: bytes | None = None
        headers = crud_probe_headers(method, marker)

        if method in CRUD_BODY_METHODS:
            payload = json.dumps(
                {
                    "probe": marker,
                    "method": method,
                    "route": route_path,
                    "operation": {
                        "POST": "create",
                        "PUT": "replace",
                        "PATCH": "partial_update",
                    }.get(method, "unknown"),
                }
            )

            body = payload.encode("utf-8")
            headers["Content-Type"] = "application/json"

        status, response_body, response_headers = _request_method(
            url,
            method=method,
            body=body,
            headers=headers,
            timeout=10,
        )

        gateway_allowed = not _is_gateway_rejection(status)

        # HEAD normally returns no body, so status is the main evidence.
        if method == "HEAD":
            backend_evidence = status is not None and status < 500
        else:
            backend_evidence = _has_backend_evidence(response_body) or (
                status is not None and 200 <= status < 300
            )

        body_echo_verified = marker in (response_body or "")

        ok = gateway_allowed and backend_evidence

        if strict_body_echo and method in CRUD_BODY_METHODS:
            ok = ok and body_echo_verified

        checks.append(
            {
                "name": f"{route_path} CRUD {method}",
                "ok": ok,
                "path": route_path,
                "probe_path": probe_path,
                "method": method,
                "status": status,
                "gateway_allowed": gateway_allowed,
                "backend_evidence": backend_evidence,
                "body_echo_verified": body_echo_verified if method in CRUD_BODY_METHODS else None,
                "strict_body_echo": strict_body_echo if method in CRUD_BODY_METHODS else None,
                "response_headers": {
                    key: value
                    for key, value in response_headers.items()
                    if key.lower() in {"content-type", "server", "x-demo-backend-port"}
                },
            }
        )

    return checks


def _check_crud_forwarding(
    routes: list[dict[str, Any]],
    live_url: str,
    *,
    strict_body_echo: bool = False,
    max_routes: int | None = None,
) -> list[dict[str, Any]]:
    checks: list[dict[str, Any]] = []

    candidates: list[dict[str, Any]] = []

    for route in routes:
        if not isinstance(route, dict):
            continue

        if _is_static_route(route):
            continue

        candidates.append(route)

    if max_routes is not None:
        candidates = candidates[:max_routes]

    for route in candidates:
        checks.extend(
            _check_crud_methods_for_route(
                route,
                live_url,
                strict_body_echo=strict_body_echo,
            )
        )

    return checks


def _check_security_policy(config: dict[str, Any], live_url: str) -> list[dict[str, Any]]:
    checks: list[dict[str, Any]] = []

    security = config.get("security") or {}

    if not isinstance(security, dict):
        return checks

    blocked_paths = security.get("blocked_paths") or []

    if isinstance(blocked_paths, list):
        for raw_path in blocked_paths:
            path = _normalize_path(raw_path)
            status, _, _ = _request_method(
                _route_url(live_url, path),
                method="GET",
                timeout=10,
            )

            checks.append(
                {
                    "name": f"blocked path {path}",
                    "ok": status is not None and status != 200,
                    "path": path,
                    "method": "GET",
                    "status": status,
                }
            )

    allowed_methods = {
        str(method).upper()
        for method in security.get("allowed_methods") or []
    }

    if allowed_methods and "TRACE" not in allowed_methods:
        status, _, _ = _request_method(
            _route_url(live_url, "/api/__gateway_crud_probe__/trace"),
            method="TRACE",
            timeout=10,
        )

        checks.append(
            {
                "name": "disallowed method TRACE rejected",
                "ok": status is not None and status != 200,
                "method": "TRACE",
                "status": status,
            }
        )

    return checks


