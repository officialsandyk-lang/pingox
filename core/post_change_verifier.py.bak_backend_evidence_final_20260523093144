def _ensure_db(db_path: Path = DEFAULT_DB_PATH) -> None:
    db_path.parent.mkdir(parents=True, exist_ok=True)

    with sqlite3.connect(db_path) as conn:
        conn.execute(
            """
            CREATE TABLE IF NOT EXISTS post_change_verification_runs (
                id INTEGER PRIMARY KEY AUTOINCREMENT,
                created_at TEXT NOT NULL,
                source TEXT,
                change_type TEXT,
                live_url TEXT,
                success INTEGER NOT NULL,
                level TEXT,
                route_count INTEGER,
                deleted_paths_json TEXT,
                checks_json TEXT,
                failure_summary TEXT
            )
            """
        )
        conn.commit()


def _store_result(result: dict[str, Any], db_path: Path = DEFAULT_DB_PATH) -> None:
    _ensure_db(db_path)

    with sqlite3.connect(db_path) as conn:
        conn.execute(
            """
            INSERT INTO post_change_verification_runs (
                created_at,
                source,
                change_type,
                live_url,
                success,
                level,
                route_count,
                deleted_paths_json,
                checks_json,
                failure_summary
            )
            VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?)
            """,
            (
                _utc_now(),
                result.get("source"),
                result.get("change_type"),
                result.get("live_url"),
                1 if result.get("success") else 0,
                result.get("level"),
                result.get("route_count"),
                json.dumps(result.get("deleted_paths") or []),
                json.dumps(result.get("checks") or [], default=str),
                result.get("failure_summary"),
            ),
        )
        conn.commit()


def verify_after_change(
    *,
    config: dict[str, Any] | None = None,
    config_path: str | Path = "generated-pingora-proxy/config.json",
    live_url: str | None = None,
    source: str = "unknown",
    change_type: str = "unknown",
    deleted_paths: list[str] | None = None,
    level: str = "smoke",
    store: bool = True,
) -> dict[str, Any]:
    level = (level or "smoke").lower().strip()

    if level == "none":
        return {
            "success": True,
            "skipped": True,
            "source": source,
            "change_type": change_type,
            "level": level,
            "checks": [],
            "failed_checks": [],
        }

    config_path = Path(config_path)

    if config is None:
        config = json.load(open(config_path))

    if live_url is None:
        port = int(config.get("port") or 8090)
        live_url = f"http://127.0.0.1:{port}/"

    deleted_paths = [_normalize_path(path) for path in (deleted_paths or [])]
    routes = config.get("routes") or []

    if not isinstance(routes, list):
        routes = []

    checks: list[dict[str, Any]] = []

    homepage_status, homepage_body = _request(live_url)

    checks.append(
        {
            "name": "homepage returns 200",
            "ok": homepage_status == 200,
            "status": homepage_status,
        }
    )

    checks.append(
        {
            "name": "homepage route-directory visible",
            "ok": "AI Pingora Gateway Route Directory" in homepage_body,
        }
    )

    for route in routes:
        if not isinstance(route, dict):
            continue

        path = _normalize_path(route.get("path") or "/")

        checks.append(
            {
                "name": f"homepage contains {path}",
                "ok": path in homepage_body,
                "path": path,
            }
        )

    if level in {"crud", "stress", "full"}:
        checks.extend(_check_security_profile_config(config))

    for path in deleted_paths:
        status, _ = _request(_route_url(live_url, path))

        checks.append(
            {
                "name": f"deleted route {path} not on homepage",
                "ok": path not in homepage_body,
                "path": path,
            }
        )

        checks.append(
            {
                "name": f"deleted route {path} does not serve 200",
                "ok": status != 200,
                "path": path,
                "status": status,
            }
        )

    for route in routes:
        if isinstance(route, dict):
            checks.append(_check_route_live(route, live_url))

    if level in {"algorithm", "stress", "full"}:
        for route in routes:
            if isinstance(route, dict):
                checks.extend(_check_algorithm(route, live_url))

    if level in {"crud", "stress", "full"}:
        checks.extend(
            _check_crud_forwarding(
                routes,
                live_url,
                strict_body_echo=(level == "full"),
            )
        )
        checks.extend(_check_security_policy(config, live_url))

    if level in {"stress", "full"}:
        checks.extend(_check_concurrent_routes(routes, live_url))

    failed = [check for check in checks if not check.get("ok")]

    result = {
        "success": not failed,
        "source": source,
        "change_type": change_type,
        "live_url": live_url,
        "level": level,
        "route_count": len(routes),
        "deleted_paths": deleted_paths,
        "checks": checks,
        "failed_checks": failed,
        "failure_summary": "; ".join(str(item.get("name")) for item in failed[:10]),
        "created_at": _utc_now(),
    }

    if store:
        _store_result(result)

    return result


def format_verification_report(result: dict[str, Any]) -> str:
    lines = [
        "🧪 Post-change verification",
        "",
        f"Success: {result.get('success')}",
        f"Source: {result.get('source')}",
        f"Change type: {result.get('change_type')}",
        f"Level: {result.get('level')}",
        f"Live URL: {result.get('live_url')}",
        f"Routes: {result.get('route_count')}",
    ]

    if result.get("skipped"):
        lines.append("")
        lines.append("Verification skipped.")
        return "\n".join(lines)

    failed = result.get("failed_checks") or []

    if failed:
        lines.append("")
        lines.append("Failed checks:")

        for item in failed:
            lines.append(f"- {item.get('name')} | {item}")
    else:
        lines.append("")
        lines.append("All checks passed ✅")

    return "\n".join(lines)


if __name__ == "__main__":
    result = verify_after_change(
        source="manual",
        change_type="manual",
        level="smoke",
    )

    print(format_verification_report(result))

    if not result.get("success"):
        raise SystemExit(1)
