def crud_probe_headers(method: str, marker: str) -> dict[str, str]:
    method = str(method or "GET").upper()

    headers = {
        "User-Agent": "ai-pingora-post-change-verifier/1.0",
        "X-Gateway-CRUD-Probe": marker,
        "X-Requested-With": "AI-Pingora-Gateway-Verifier",
    }

    if method in {"POST", "PUT", "PATCH", "DELETE"}:
        headers["Content-Type"] = "application/json"
        headers["Idempotency-Key"] = marker

    return headers


def crud_probe_body(method: str, marker: str) -> bytes | None:
    method = str(method or "GET").upper()

    if method in {"POST", "PUT", "PATCH", "DELETE"}:
        return ('{"probe":"' + marker + '"}').encode("utf-8")

    return None

def _utc_now() -> str:
    return datetime.now(UTC).isoformat()


def _normalize_path(path: Any) -> str:
    text = str(path or "/").strip()

    if not text.startswith("/"):
        text = "/" + text

    if len(text) > 1:
        text = text.rstrip("/")

    return text or "/"


def _request(url: str, timeout: int = 10) -> tuple[int | None, str]:
    try:
        with urllib.request.urlopen(url, timeout=timeout) as response:
            return int(response.status), response.read().decode("utf-8", errors="replace")
    except urllib.error.HTTPError as exc:
        try:
            return int(exc.code), exc.read().decode("utf-8", errors="replace")
        except Exception:
            return int(exc.code), str(exc)
    except Exception as exc:
        return None, str(exc)


def _route_url(live_url: str, path: str) -> str:
    base = live_url.rstrip("/")
    path = _normalize_path(path)

    if path == "/":
        return base + "/"

    return base + path.rstrip("/") + "/"


def _extract_backend_port(body: str) -> str | None:
    """
    Extract backend port from verifier/demo backend responses.

    Handles:
    - "backend_port": 9101
    - "port": 9101
    - X-Demo-Backend-Port evidence copied into body
    - host.docker.internal:9101
    - 127.0.0.1:9101
    - plain text containing 9101/9102/9103
    """
    if body is None:
        return None

    if isinstance(body, bytes):
        text = body.decode("utf-8", errors="replace")
    else:
        text = str(body)

    if not text.strip():
        return None

    # Direct JSON-key regex. This is the most important fix.
    for pattern in [
        r'"backend_port"\s*:\s*"?([0-9]{2,5})"?',
        r'"selected_backend"\s*:\s*"?([0-9]{2,5})"?',
        r'"selected_backend_port"\s*:\s*"?([0-9]{2,5})"?',
        r'"upstream_port"\s*:\s*"?([0-9]{2,5})"?',
        r'"port"\s*:\s*"?([0-9]{2,5})"?',
        r'X-Demo-Backend-Port\s*:?\s*"?([0-9]{2,5})"?',
        r'X-Backend-Port\s*:?\s*"?([0-9]{2,5})"?',
        r'X-Selected-Backend\s*:?\s*"?([0-9]{2,5})"?',
    ]:
        match = re.search(pattern, text, flags=re.IGNORECASE)
        if match:
            port = int(match.group(1))
            if 1 <= port <= 65535:
                return str(port)

    # Host:port evidence.
    match = re.search(
        r'(?:127\.0\.0\.1|localhost|host\.docker\.internal):([0-9]{2,5})',
        text,
        flags=re.IGNORECASE,
    )
    if match:
        port = int(match.group(1))
        if 1 <= port <= 65535:
            return str(port)

    # JSON parse fallback.
    try:
        parsed = json.loads(text)

        def walk(value):
            if isinstance(value, dict):
                for key in [
                    "backend_port",
                    "port",
                    "selected_backend",
                    "selected_backend_port",
                    "upstream_port",
                    "server_port",
                ]:
                    if key in value:
                        try:
                            port = int(str(value[key]))
                            if 1 <= port <= 65535:
                                return str(port)
                        except Exception:
                            pass

                for child in value.values():
                    found = walk(child)
                    if found:
                        return found

            if isinstance(value, list):
                for child in value:
                    found = walk(child)
                    if found:
                        return found

            if isinstance(value, str):
                found = _extract_backend_port(value)
                if found:
                    return found

            return None

        found = walk(parsed)
        if found:
            return found

    except Exception:
        pass

    # Last fallback: known backend port ranges used in your project.
    match = re.search(r'\b(9[0-9]{3}|10[0-9]{3})\b', text)
    if match:
        return match.group(1)

    return None


def _is_static_route(route: dict[str, Any]) -> bool:
    return str(route.get("type") or "").lower() in {
        "static",
        "web",
        "webserver",
        "web_server",
        "file_server",
        "files",
    }


def _route_ports(route: dict[str, Any]) -> list[str]:
    ports: list[str] = []

    upstreams = route.get("upstreams")

    if isinstance(upstreams, list):
        for item in upstreams:
            if isinstance(item, dict):
                address = str(item.get("address") or item.get("upstream") or item.get("backend") or "")
            else:
                address = str(item or "")

            if ":" in address:
                ports.append(address.rsplit(":", 1)[-1])
    else:
        address = str(route.get("upstream") or route.get("backend") or "")

        if ":" in address:
            ports.append(address.rsplit(":", 1)[-1])

    return [port for port in ports if port]


def _route_weights(route: dict[str, Any]) -> list[int]:
    upstreams = route.get("upstreams")

    if not isinstance(upstreams, list):
        return []

    weights: list[int] = []

    for item in upstreams:
        if isinstance(item, dict):
            try:
                weights.append(max(int(item.get("weight", 1)), 1))
            except Exception:
                weights.append(1)
        else:
            weights.append(1)

    return weights


def _check_route_live(route: dict[str, Any], live_url: str) -> dict[str, Any]:
    path = _normalize_path(route.get("path") or "/")
    status, body = _request(_route_url(live_url, path))

    if path == "/" or _is_static_route(route):
        ok = status == 200
    else:
        ok = status == 200 and "Demo Backend" in body

    return {
        "name": f"{path} live route check",
        "ok": ok,
        "path": path,
        "status": status,
    }


def _check_algorithm(route: dict[str, Any], live_url: str) -> list[dict[str, Any]]:
    checks: list[dict[str, Any]] = []

    path = _normalize_path(route.get("path") or "/")

    if path == "/" or _is_static_route(route):
        return checks

    algorithm = route.get("balancing")
    ports = _route_ports(route)

    if not ports:
        return checks

    if len(ports) == 1:
        status, body = _request(_route_url(live_url, path))
        backend = _extract_backend_port(body)

        checks.append(
            {
                "name": f"{path} single backend",
                "ok": status == 200 and backend == ports[0],
                "path": path,
                "status": status,
                "backend": backend,
                "expected": ports[0],
            }
        )
        return checks

    if algorithm == "random":
        counts: Counter[str] = Counter()

        for _ in range(60):
            status, body = _request(_route_url(live_url, path))
            backend = _extract_backend_port(body)

            if status == 200 and backend:
                counts[backend] += 1

        checks.append(
            {
                "name": f"{path} random uses all backends",
                "ok": set(ports).issubset(set(counts)),
                "path": path,
                "algorithm": algorithm,
                "counts": dict(counts),
                "expected_ports": ports,
            }
        )

    elif algorithm == "round_robin":
        sequence: list[str] = []

        for _ in range(len(ports) * 3):
            status, body = _request(_route_url(live_url, path))
            backend = _extract_backend_port(body)

            if status == 200 and backend:
                sequence.append(backend)

        ok = False

        if len(sequence) == len(ports) * 3:
            for offset in range(len(ports)):
                expected = [
                    ports[(index + offset) % len(ports)]
                    for index in range(len(sequence))
                ]

                if sequence == expected:
                    ok = True
                    break

        checks.append(
            {
                "name": f"{path} round_robin cycle",
                "ok": ok,
                "path": path,
                "algorithm": algorithm,
                "sequence": sequence,
                "expected_ports": ports,
            }
        )

    elif algorithm == "weighted_round_robin":
        weights = _route_weights(route)

        if len(weights) != len(ports):
            checks.append(
                {
                    "name": f"{path} weighted weights present",
                    "ok": False,
                    "path": path,
                    "ports": ports,
                    "weights": weights,
                }
            )
            return checks

        multiplier = 10
        total = sum(weights) * multiplier
        expected = {
            port: weight * multiplier
            for port, weight in zip(ports, weights)
        }

        counts: Counter[str] = Counter()

        for _ in range(total):
            status, body = _request(_route_url(live_url, path))
            backend = _extract_backend_port(body)

            if status == 200 and backend:
                counts[backend] += 1

        checks.append(
            {
                "name": f"{path} weighted_round_robin ratio",
                "ok": dict(counts) == expected,
                "path": path,
                "algorithm": algorithm,
                "counts": dict(counts),
                "expected": expected,
            }
        )

    elif algorithm == "ip_hash":
        counts: Counter[str] = Counter()

        for _ in range(20):
            status, body = _request(_route_url(live_url, path))
            backend = _extract_backend_port(body)

            if status == 200 and backend:
                counts[backend] += 1

        checks.append(
            {
                "name": f"{path} ip_hash sticky",
                "ok": len(counts) == 1 and sum(counts.values()) == 20,
                "path": path,
                "algorithm": algorithm,
                "counts": dict(counts),
            }
        )

    elif algorithm == "least_connections":
        counts: Counter[str] = Counter()

        for _ in range(len(ports) * 10):
            status, body = _request(_route_url(live_url, path))
            backend = _extract_backend_port(body)

            if status == 200 and backend:
                counts[backend] += 1

        checks.append(
            {
                "name": f"{path} least_connections uses all backends",
                "ok": set(ports).issubset(set(counts)),
                "path": path,
                "algorithm": algorithm,
                "counts": dict(counts),
                "expected_ports": ports,
            }
        )

    return checks


def _check_concurrent_routes(
    routes: list[dict[str, Any]],
    live_url: str,
    requests_per_route: int = 50,
    max_workers: int = 30,
) -> list[dict[str, Any]]:
    checks: list[dict[str, Any]] = []

    def one_request(path: str) -> tuple[str, int | None]:
        status, _ = _request(_route_url(live_url, path), timeout=10)
        return path, status

    futures = []

    with ThreadPoolExecutor(max_workers=max_workers) as executor:
        for route in routes:
            if not isinstance(route, dict):
                continue

            path = _normalize_path(route.get("path") or "/")

            for _ in range(requests_per_route):
                futures.append(executor.submit(one_request, path))

        counters: dict[str, Counter[str]] = {}

        for future in as_completed(futures):
            path, status = future.result()
            counters.setdefault(path, Counter())[str(status)] += 1

    for path, counts in counters.items():
        checks.append(
            {
                "name": f"{path} concurrent all 200",
                "ok": counts == {"200": requests_per_route},
                "path": path,
                "counts": dict(counts),
            }
        )

    return checks



