def _check_security_profile_config(config: dict[str, Any]) -> list[dict[str, Any]]:
    checks: list[dict[str, Any]] = []

    security = config.get("security") or {}

    if not isinstance(security, dict):
        checks.append(
            {
                "name": "security profile exists",
                "ok": False,
                "reason": "config.security missing or not a dict",
            }
        )
        return checks

    required_methods = {"GET", "POST", "PUT", "PATCH", "DELETE", "OPTIONS", "HEAD"}
    allowed_methods = {
        str(method).upper()
        for method in security.get("allowed_methods") or []
    }

    checks.append(
        {
            "name": "global CRUD methods allowlist configured",
            "ok": required_methods.issubset(allowed_methods),
            "expected": sorted(required_methods),
            "actual": sorted(allowed_methods),
        }
    )

    blocked_paths = {
        _normalize_path(path)
        for path in security.get("blocked_paths") or []
    }

    expected_blocked = {"/.env", "/.git", "/admin.php", "/phpmyadmin", "/wp-admin", "/wp-login.php"}

    checks.append(
        {
            "name": "blocked paths configured",
            "ok": expected_blocked.issubset(blocked_paths),
            "expected_subset": sorted(expected_blocked),
            "actual": sorted(blocked_paths),
        }
    )

    checks.append(
        {
            "name": "body size limit configured",
            "ok": int(security.get("max_request_body_bytes") or 0) > 0,
            "max_request_body_bytes": security.get("max_request_body_bytes"),
        }
    )

    https = security.get("https") or {}

    checks.append(
        {
            "name": "HTTPS config support present",
            "ok": isinstance(https, dict) and "production_required" in https,
            "https": https,
        }
    )

    method_limits = security.get("method_rate_limits_per_minute") or {}

    required_method_limits = {"GET", "POST", "PUT", "PATCH", "DELETE", "OPTIONS", "HEAD"}

    checks.append(
        {
            "name": "per-method rate limits configured",
            "ok": isinstance(method_limits, dict)
            and required_method_limits.issubset({str(k).upper() for k in method_limits.keys()}),
            "method_rate_limits_per_minute": method_limits,
        }
    )

    content_type_policy = security.get("content_type_policy") or {}

    checks.append(
        {
            "name": "JSON/content-type policy configured",
            "ok": bool(content_type_policy.get("enabled"))
            and "application/json" in (content_type_policy.get("allowed_content_types") or []),
            "content_type_policy": content_type_policy,
        }
    )

    idempotency_policy = security.get("idempotency_policy") or {}

    checks.append(
        {
            "name": "idempotency policy configured",
            "ok": bool(idempotency_policy.get("enabled"))
            and bool(idempotency_policy.get("required_header")),
            "idempotency_policy": idempotency_policy,
        }
    )

    audit_policy = security.get("audit_policy") or {}

    checks.append(
        {
            "name": "CRUD mutation audit policy configured",
            "ok": bool(audit_policy.get("enabled"))
            and bool(audit_policy.get("log_path"))
            and set(["POST", "PUT", "PATCH", "DELETE"]).issubset(
                {str(m).upper() for m in audit_policy.get("methods") or []}
            ),
            "audit_policy": audit_policy,
        }
    )

    crud_probe_policy = security.get("crud_probe_policy") or {}

    checks.append(
        {
            "name": "staging-safe CRUD probes configured",
            "ok": bool(crud_probe_policy.get("enabled"))
            and bool(crud_probe_policy.get("staging_safe_only")),
            "crud_probe_policy": crud_probe_policy,
        }
    )

    routes = config.get("routes") or []

    route_policy_missing: list[str] = []

    if isinstance(routes, list):
        for route in routes:
            if not isinstance(route, dict):
                continue

            if _is_static_route(route):
                continue

            path = _normalize_path(route.get("path") or "/")
            route_methods = {
                str(method).upper()
                for method in route.get("allowed_methods") or []
            }
            crud_policy = route.get("crud_policy") or {}

            if not required_methods.issubset(route_methods) or not crud_policy.get("enabled"):
                route_policy_missing.append(path)

    checks.append(
        {
            "name": "per-route method allowlists and CRUD policies configured",
            "ok": not route_policy_missing,
            "routes_missing_policy": route_policy_missing,
        }
    )

    return checks


