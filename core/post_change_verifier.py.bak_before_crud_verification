from __future__ import annotations

import json
import re
import sqlite3
import urllib.error
import urllib.request
from collections import Counter
from concurrent.futures import ThreadPoolExecutor, as_completed
from datetime import UTC, datetime
from pathlib import Path
from typing import Any


PROJECT_ROOT = Path(__file__).resolve().parents[1]
DEFAULT_DB_PATH = PROJECT_ROOT / "data" / "reliability_reports.sqlite3"


def _utc_now() -> str:
    return datetime.now(UTC).isoformat()


def _normalize_path(path: Any) -> str:
    text = str(path or "/").strip()

    if not text.startswith("/"):
        text = "/" + text

    if len(text) > 1:
        text = text.rstrip("/")

    return text or "/"


def _request(url: str, timeout: int = 10) -> tuple[int | None, str]:
    try:
        with urllib.request.urlopen(url, timeout=timeout) as response:
            return int(response.status), response.read().decode("utf-8", errors="replace")
    except urllib.error.HTTPError as exc:
        try:
            return int(exc.code), exc.read().decode("utf-8", errors="replace")
        except Exception:
            return int(exc.code), str(exc)
    except Exception as exc:
        return None, str(exc)


def _route_url(live_url: str, path: str) -> str:
    base = live_url.rstrip("/")
    path = _normalize_path(path)

    if path == "/":
        return base + "/"

    return base + path.rstrip("/") + "/"


def _extract_backend_port(body: str) -> str | None:
    match = re.search(r"Demo Backend (\d+)", body or "")

    if match:
        return match.group(1)

    return None


def _is_static_route(route: dict[str, Any]) -> bool:
    return str(route.get("type") or "").lower() in {
        "static",
        "web",
        "webserver",
        "web_server",
        "file_server",
        "files",
    }


def _route_ports(route: dict[str, Any]) -> list[str]:
    ports: list[str] = []

    upstreams = route.get("upstreams")

    if isinstance(upstreams, list):
        for item in upstreams:
            if isinstance(item, dict):
                address = str(item.get("address") or item.get("upstream") or item.get("backend") or "")
            else:
                address = str(item or "")

            if ":" in address:
                ports.append(address.rsplit(":", 1)[-1])
    else:
        address = str(route.get("upstream") or route.get("backend") or "")

        if ":" in address:
            ports.append(address.rsplit(":", 1)[-1])

    return [port for port in ports if port]


def _route_weights(route: dict[str, Any]) -> list[int]:
    upstreams = route.get("upstreams")

    if not isinstance(upstreams, list):
        return []

    weights: list[int] = []

    for item in upstreams:
        if isinstance(item, dict):
            try:
                weights.append(max(int(item.get("weight", 1)), 1))
            except Exception:
                weights.append(1)
        else:
            weights.append(1)

    return weights


def _check_route_live(route: dict[str, Any], live_url: str) -> dict[str, Any]:
    path = _normalize_path(route.get("path") or "/")
    status, body = _request(_route_url(live_url, path))

    if path == "/" or _is_static_route(route):
        ok = status == 200
    else:
        ok = status == 200 and "Demo Backend" in body

    return {
        "name": f"{path} live route check",
        "ok": ok,
        "path": path,
        "status": status,
    }


def _check_algorithm(route: dict[str, Any], live_url: str) -> list[dict[str, Any]]:
    checks: list[dict[str, Any]] = []

    path = _normalize_path(route.get("path") or "/")

    if path == "/" or _is_static_route(route):
        return checks

    algorithm = route.get("balancing")
    ports = _route_ports(route)

    if not ports:
        return checks

    if len(ports) == 1:
        status, body = _request(_route_url(live_url, path))
        backend = _extract_backend_port(body)

        checks.append(
            {
                "name": f"{path} single backend",
                "ok": status == 200 and backend == ports[0],
                "path": path,
                "status": status,
                "backend": backend,
                "expected": ports[0],
            }
        )
        return checks

    if algorithm == "random":
        counts: Counter[str] = Counter()

        for _ in range(60):
            status, body = _request(_route_url(live_url, path))
            backend = _extract_backend_port(body)

            if status == 200 and backend:
                counts[backend] += 1

        checks.append(
            {
                "name": f"{path} random uses all backends",
                "ok": set(ports).issubset(set(counts)),
                "path": path,
                "algorithm": algorithm,
                "counts": dict(counts),
                "expected_ports": ports,
            }
        )

    elif algorithm == "round_robin":
        sequence: list[str] = []

        for _ in range(len(ports) * 3):
            status, body = _request(_route_url(live_url, path))
            backend = _extract_backend_port(body)

            if status == 200 and backend:
                sequence.append(backend)

        ok = False

        if len(sequence) == len(ports) * 3:
            for offset in range(len(ports)):
                expected = [
                    ports[(index + offset) % len(ports)]
                    for index in range(len(sequence))
                ]

                if sequence == expected:
                    ok = True
                    break

        checks.append(
            {
                "name": f"{path} round_robin cycle",
                "ok": ok,
                "path": path,
                "algorithm": algorithm,
                "sequence": sequence,
                "expected_ports": ports,
            }
        )

    elif algorithm == "weighted_round_robin":
        weights = _route_weights(route)

        if len(weights) != len(ports):
            checks.append(
                {
                    "name": f"{path} weighted weights present",
                    "ok": False,
                    "path": path,
                    "ports": ports,
                    "weights": weights,
                }
            )
            return checks

        multiplier = 10
        total = sum(weights) * multiplier
        expected = {
            port: weight * multiplier
            for port, weight in zip(ports, weights)
        }

        counts: Counter[str] = Counter()

        for _ in range(total):
            status, body = _request(_route_url(live_url, path))
            backend = _extract_backend_port(body)

            if status == 200 and backend:
                counts[backend] += 1

        checks.append(
            {
                "name": f"{path} weighted_round_robin ratio",
                "ok": dict(counts) == expected,
                "path": path,
                "algorithm": algorithm,
                "counts": dict(counts),
                "expected": expected,
            }
        )

    elif algorithm == "ip_hash":
        counts: Counter[str] = Counter()

        for _ in range(20):
            status, body = _request(_route_url(live_url, path))
            backend = _extract_backend_port(body)

            if status == 200 and backend:
                counts[backend] += 1

        checks.append(
            {
                "name": f"{path} ip_hash sticky",
                "ok": len(counts) == 1 and sum(counts.values()) == 20,
                "path": path,
                "algorithm": algorithm,
                "counts": dict(counts),
            }
        )

    elif algorithm == "least_connections":
        counts: Counter[str] = Counter()

        for _ in range(len(ports) * 10):
            status, body = _request(_route_url(live_url, path))
            backend = _extract_backend_port(body)

            if status == 200 and backend:
                counts[backend] += 1

        checks.append(
            {
                "name": f"{path} least_connections uses all backends",
                "ok": set(ports).issubset(set(counts)),
                "path": path,
                "algorithm": algorithm,
                "counts": dict(counts),
                "expected_ports": ports,
            }
        )

    return checks


def _check_concurrent_routes(
    routes: list[dict[str, Any]],
    live_url: str,
    requests_per_route: int = 50,
    max_workers: int = 30,
) -> list[dict[str, Any]]:
    checks: list[dict[str, Any]] = []

    def one_request(path: str) -> tuple[str, int | None]:
        status, _ = _request(_route_url(live_url, path), timeout=10)
        return path, status

    futures = []

    with ThreadPoolExecutor(max_workers=max_workers) as executor:
        for route in routes:
            if not isinstance(route, dict):
                continue

            path = _normalize_path(route.get("path") or "/")

            for _ in range(requests_per_route):
                futures.append(executor.submit(one_request, path))

        counters: dict[str, Counter[str]] = {}

        for future in as_completed(futures):
            path, status = future.result()
            counters.setdefault(path, Counter())[str(status)] += 1

    for path, counts in counters.items():
        checks.append(
            {
                "name": f"{path} concurrent all 200",
                "ok": counts == {"200": requests_per_route},
                "path": path,
                "counts": dict(counts),
            }
        )

    return checks


def _ensure_db(db_path: Path = DEFAULT_DB_PATH) -> None:
    db_path.parent.mkdir(parents=True, exist_ok=True)

    with sqlite3.connect(db_path) as conn:
        conn.execute(
            """
            CREATE TABLE IF NOT EXISTS post_change_verification_runs (
                id INTEGER PRIMARY KEY AUTOINCREMENT,
                created_at TEXT NOT NULL,
                source TEXT,
                change_type TEXT,
                live_url TEXT,
                success INTEGER NOT NULL,
                level TEXT,
                route_count INTEGER,
                deleted_paths_json TEXT,
                checks_json TEXT,
                failure_summary TEXT
            )
            """
        )
        conn.commit()


def _store_result(result: dict[str, Any], db_path: Path = DEFAULT_DB_PATH) -> None:
    _ensure_db(db_path)

    with sqlite3.connect(db_path) as conn:
        conn.execute(
            """
            INSERT INTO post_change_verification_runs (
                created_at,
                source,
                change_type,
                live_url,
                success,
                level,
                route_count,
                deleted_paths_json,
                checks_json,
                failure_summary
            )
            VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?)
            """,
            (
                _utc_now(),
                result.get("source"),
                result.get("change_type"),
                result.get("live_url"),
                1 if result.get("success") else 0,
                result.get("level"),
                result.get("route_count"),
                json.dumps(result.get("deleted_paths") or []),
                json.dumps(result.get("checks") or [], default=str),
                result.get("failure_summary"),
            ),
        )
        conn.commit()


def verify_after_change(
    *,
    config: dict[str, Any] | None = None,
    config_path: str | Path = "generated-pingora-proxy/config.json",
    live_url: str | None = None,
    source: str = "unknown",
    change_type: str = "unknown",
    deleted_paths: list[str] | None = None,
    level: str = "smoke",
    store: bool = True,
) -> dict[str, Any]:
    level = (level or "smoke").lower().strip()

    if level == "none":
        return {
            "success": True,
            "skipped": True,
            "source": source,
            "change_type": change_type,
            "level": level,
            "checks": [],
            "failed_checks": [],
        }

    config_path = Path(config_path)

    if config is None:
        config = json.load(open(config_path))

    if live_url is None:
        port = int(config.get("port") or 8090)
        live_url = f"http://127.0.0.1:{port}/"

    deleted_paths = [_normalize_path(path) for path in (deleted_paths or [])]
    routes = config.get("routes") or []

    if not isinstance(routes, list):
        routes = []

    checks: list[dict[str, Any]] = []

    homepage_status, homepage_body = _request(live_url)

    checks.append(
        {
            "name": "homepage returns 200",
            "ok": homepage_status == 200,
            "status": homepage_status,
        }
    )

    checks.append(
        {
            "name": "homepage route-directory visible",
            "ok": "AI Pingora Gateway Route Directory" in homepage_body,
        }
    )

    for route in routes:
        if not isinstance(route, dict):
            continue

        path = _normalize_path(route.get("path") or "/")

        checks.append(
            {
                "name": f"homepage contains {path}",
                "ok": path in homepage_body,
                "path": path,
            }
        )

    for path in deleted_paths:
        status, _ = _request(_route_url(live_url, path))

        checks.append(
            {
                "name": f"deleted route {path} not on homepage",
                "ok": path not in homepage_body,
                "path": path,
            }
        )

        checks.append(
            {
                "name": f"deleted route {path} does not serve 200",
                "ok": status != 200,
                "path": path,
                "status": status,
            }
        )

    for route in routes:
        if isinstance(route, dict):
            checks.append(_check_route_live(route, live_url))

    if level in {"algorithm", "stress"}:
        for route in routes:
            if isinstance(route, dict):
                checks.extend(_check_algorithm(route, live_url))

    if level == "stress":
        checks.extend(_check_concurrent_routes(routes, live_url))

    failed = [check for check in checks if not check.get("ok")]

    result = {
        "success": not failed,
        "source": source,
        "change_type": change_type,
        "live_url": live_url,
        "level": level,
        "route_count": len(routes),
        "deleted_paths": deleted_paths,
        "checks": checks,
        "failed_checks": failed,
        "failure_summary": "; ".join(str(item.get("name")) for item in failed[:10]),
        "created_at": _utc_now(),
    }

    if store:
        _store_result(result)

    return result


def format_verification_report(result: dict[str, Any]) -> str:
    lines = [
        "🧪 Post-change verification",
        "",
        f"Success: {result.get('success')}",
        f"Source: {result.get('source')}",
        f"Change type: {result.get('change_type')}",
        f"Level: {result.get('level')}",
        f"Live URL: {result.get('live_url')}",
        f"Routes: {result.get('route_count')}",
    ]

    if result.get("skipped"):
        lines.append("")
        lines.append("Verification skipped.")
        return "\n".join(lines)

    failed = result.get("failed_checks") or []

    if failed:
        lines.append("")
        lines.append("Failed checks:")

        for item in failed:
            lines.append(f"- {item.get('name')} | {item}")
    else:
        lines.append("")
        lines.append("All checks passed ✅")

    return "\n".join(lines)


if __name__ == "__main__":
    result = verify_after_change(
        source="manual",
        change_type="manual",
        level="smoke",
    )

    print(format_verification_report(result))

    if not result.get("success"):
        raise SystemExit(1)
