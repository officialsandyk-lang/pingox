# Main graph
# ---------------------------------------------------------------------


@traceable(name="update_gateway_flow", run_type="chain")
def run_update_graph(
    prompt: str,
    *,
    runtime: str | None = None,
    strategy: str | None = None,
    confirm_route_mutation: bool = False,
    verification_level: str = "auto",
) -> dict[str, Any]:
    load_dotenv()

    prompt = prompt or ""
    reliability = ReliabilityBrain()
    run_id = reliability.start_run(prompt, flow="update")

    stage = "load_active_config"
    active_color = "blue"
    active_config: dict[str, Any] | None = None
    project_dir: Path | None = None
    change_summary: list[str] = []

    try:
        active_config, active_color = load_active_config()

        resolved_runtime, resolved_strategy = _resolve_runtime_and_strategy(
            active_config=active_config,
            prompt=prompt,
            runtime=runtime,
            strategy=strategy,
        )

        generated_config = _read_json(GENERATED_PROJECT_DIR / "config.json")

        if isinstance(generated_config, dict) and resolved_runtime == "local":
            active_config = generated_config

            if _is_local_direct(resolved_runtime, resolved_strategy):
                active_color = "local"

            resolved_runtime, resolved_strategy = _resolve_runtime_and_strategy(
                active_config=active_config,
                prompt=prompt,
                runtime=runtime,
                strategy=strategy,
            )

        dangerous_route_mutations = _detect_dangerous_route_mutations(
            active_config,
            prompt,
        )

        if dangerous_route_mutations and not (
            confirm_route_mutation or _route_mutation_confirmation_present(prompt)
        ):
            warning_response = _build_route_mutation_warning_response(
                active_config=active_config,
                warnings=dangerous_route_mutations,
                live_url=_live_url_for_config(active_config),
                run_id=run_id,
            )

            print("")
            print(warning_response["warning"])

            try:
                reliability.finish_run(
                    run_id,
                    status="requires_confirmation",
                    metadata={
                        "requires_confirmation": True,
                        "planned_route_mutations": dangerous_route_mutations,
                    },
                )
            except Exception:
                pass

            return warning_response

        stage = "update_prompt_to_config"
        update_result = update_prompt_to_config(active_config, prompt)

        if not isinstance(update_result, dict):
            update_result = {
                "config": active_config,
                "change_summary": ["No effective config changes detected."],
                "changed": False,
                "understood": False,
            }

        if isinstance(update_result.get("config"), dict):
            updated_config = update_result["config"]
        elif isinstance(update_result.get("updated_config"), dict):
            updated_config = update_result["updated_config"]
        elif "routes" in update_result:
            updated_config = update_result
        else:
            updated_config = active_config

        if not isinstance(updated_config, dict):
            updated_config = active_config

        change_summary = _normalize_summary(
            update_result.get("change_summary")
            or update_result.get("summary")
            or []
        )

        changed = bool(update_result.get("changed", False))
        understood = bool(update_result.get("understood", False))

        fallback_base_config = deepcopy(active_config)

        if isinstance(updated_config, dict) and isinstance(updated_config.get("security"), dict):
            fallback_base_config["security"] = deepcopy(updated_config["security"])

        route_mutated_config, prompt_route_changes = _apply_prompt_route_mutations(
            fallback_base_config,
            prompt,
        )

        if prompt_route_changes:
            updated_config = route_mutated_config
            changed = True
            understood = True
            change_summary.extend(prompt_route_changes)

        if not change_summary:
            change_summary = ["No effective config changes detected."]

        change_summary = _dedupe_summary(change_summary)

        if _should_skip_deploy(
            changed=changed,
            understood=understood,
            change_summary=change_summary,
        ):
            reliability.finish_run(
                run_id,
                status="success",
                metadata={
                    "skipped_deploy": True,
                    "reason": "no_effective_config_change",
                    "active_color": active_color,
                    "runtime": resolved_runtime,
                    "strategy": resolved_strategy,
                },
            )

            return {
                "success": True,
                "deployed": False,
                "skipped_deploy": True,
                "active_color": active_color,
                "live_url": _live_url_for_config(active_config),
                "config": active_config,
                "change_summary": change_summary,
                "runtime": resolved_runtime,
                "strategy": resolved_strategy,
                "run_id": run_id,
            }

        updated_config["runtime"] = resolved_runtime
        updated_config["runtime_mode"] = resolved_runtime
        updated_config["strategy"] = resolved_strategy
        updated_config["deployment_strategy"] = resolved_strategy

        stage = "config_repair"
        repaired_config = run_config_repair(updated_config, prompt)

        stage = "security"
        secured_config = run_security(repaired_config, prompt)

        secured_config["runtime"] = resolved_runtime
        secured_config["runtime_mode"] = resolved_runtime
        secured_config["strategy"] = resolved_strategy
        secured_config["deployment_strategy"] = resolved_strategy

        stage = "runtime_addressing"
        addressed_config = run_runtime_addressing(secured_config, resolved_runtime)

        addressed_config["runtime"] = resolved_runtime
        addressed_config["runtime_mode"] = resolved_runtime
        addressed_config["strategy"] = resolved_strategy
        addressed_config["deployment_strategy"] = resolved_strategy

        stage = "validator"
        final_config = run_validator(addressed_config)

        final_config["runtime"] = resolved_runtime
        final_config["runtime_mode"] = resolved_runtime
        final_config["strategy"] = resolved_strategy
        final_config["deployment_strategy"] = resolved_strategy

        final_config = apply_local_production_security_profile(
            final_config,
            environment=resolved_runtime,
        )

        stage = "config_preflight"
        run_config_preflight(final_config, resolved_runtime, resolved_strategy)

        build_dir = STAGING_DIR

        if build_dir.exists():
            shutil.rmtree(build_dir)

        stage = "project_writer"
        project_dir = run_project_writer(final_config, project_dir=build_dir)

        if not isinstance(project_dir, Path):
            project_dir = build_dir

        if _is_bluegreen(resolved_strategy):
            stage = "container_files"
            run_container_files(final_config, project_dir)

        stage = "cargo_check"
        run_cargo_check(prompt, final_config, project_dir)

        if _is_bluegreen(resolved_strategy):
            stage = "bluegreen_deploy"
            deploy_result = run_bluegreen_deploy(
                config=final_config,
                project_dir=project_dir,
                active_color=active_color,
                run_id=run_id,
            )
        elif _is_local_direct(resolved_runtime, resolved_strategy):
            stage = "local_direct_deploy"
            deploy_result = run_local_direct_deploy(
                config=final_config,
                project_dir=project_dir,
                run_id=run_id,
            )
        else:
            raise RuntimeError(
                f"Unsupported update deployment mode: runtime={resolved_runtime}, strategy={resolved_strategy}. "
                "Use strategy=bluegreen for zero-downtime updates or direct update for local development."
            )

        if not isinstance(deploy_result, dict):
            deploy_result = {}

        route_mutation_warnings = locals().get("dangerous_route_mutations") or []

        deleted_paths = [
            item["path"]
            for item in route_mutation_warnings
            if item.get("type") == "delete_route"
        ]

        resolved_verification_level = (verification_level or "auto").lower().strip()

        if resolved_verification_level == "auto":
            has_algorithm_edit = any(
                item.get("type") == "edit_route_algorithm"
                for item in route_mutation_warnings
            )

            if has_algorithm_edit:
                resolved_verification_level = "algorithm"
            else:
                resolved_verification_level = "smoke"

        if resolved_verification_level != "none":
            from core.post_change_verifier import (
                format_verification_report,
                verify_after_change,
            )

            verification = verify_after_change(
                config=final_config,
                config_path=GENERATED_PROJECT_DIR / "config.json",
                live_url=deploy_result.get("live_url") or _live_url_for_config(final_config),
                source="update_graph",
                change_type="route_update",
                deleted_paths=deleted_paths,
                level=resolved_verification_level,
                store=True,
            )

            print("")
            print(format_verification_report(verification))

            if not verification.get("success"):
                raise RuntimeError(
                    "Post-change verification failed: "
                    + str(verification.get("failure_summary"))
                )
        else:
            verification = {
                "success": True,
                "skipped": True,
                "level": "none",
            }

        deployed = bool(
            deploy_result.get("deployed")
            or deploy_result.get("success")
            or deploy_result.get("deployment_success")
        )

        new_active_color = (
            deploy_result.get("active_color")
            or deploy_result.get("color")
            or (_inactive_color(active_color) if _is_bluegreen(resolved_strategy) else active_color)
        )

        success = bool(deploy_result.get("success", deployed))

        if success and deployed:
            _save_latest_config(final_config, str(new_active_color))

        reliability.finish_run(
            run_id,
            status="success" if success else "failed",
            metadata={
                "deployed": deployed,
                "active_color": new_active_color if deployed else active_color,
                "live_url": deploy_result.get("live_url") or _live_url_for_config(final_config),
                "change_summary": change_summary,
                "runtime": resolved_runtime,
                "strategy": resolved_strategy,
                "update_mode": deploy_result.get("update_mode"),
            },
        )

        return {
            "success": success,
            "deployed": deployed,
            "skipped_deploy": False,
            "active_color": new_active_color if deployed else active_color,
            "live_url": deploy_result.get("live_url") or _live_url_for_config(final_config),
            "config": final_config,
            "change_summary": change_summary,
            "runtime": resolved_runtime,
            "strategy": resolved_strategy,
            "update_mode": deploy_result.get("update_mode")
            or ("bluegreen" if _is_bluegreen(resolved_strategy) else "local_direct_staged"),
            "restart_performed": bool(deploy_result.get("restart_performed", False)),
            "backup": deploy_result.get("backup"),
            "run_id": run_id,
            "verification": verification,
        }

    except Exception as exc:
        failure_stage = _stage_for_exception(stage, exc)

        reliability_result = reliability.record_failure(
            run_id=run_id,
            stage=failure_stage,
            error=exc,
            evidence={
                "prompt": prompt,
                "active_color": active_color,
                "active_config": active_config or {},
                "change_summary": change_summary,
                "project_dir": str(project_dir) if project_dir else None,
            },
            traffic_switched=False,
            finish_run=True,
        )

        print("")
        print(reliability_result.report)

        return {
            "success": False,
            "deployed": False,
            "skipped_deploy": False,
            "active_color": active_color,
            "live_url": _live_url_for_config(active_config or {}),
            "config": active_config or {},
            "change_summary": change_summary or ["Update failed before deployment."],
            "error": str(exc),
            "failed_node": failure_stage,
            "reliability_report": reliability_result.report,
            "incident_id": reliability_result.incident_id,
            "root_cause": reliability_result.classification.root_cause,
            "run_id": run_id,
        }


