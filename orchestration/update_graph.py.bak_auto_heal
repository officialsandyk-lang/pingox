def _resolve_runtime_and_strategy(
    *,
    active_config: dict[str, Any],
    prompt: str,
    runtime: str | None,
    strategy: str | None,
) -> tuple[str, str]:
    resolved_runtime = str(
        runtime
        or active_config.get("runtime_mode")
        or active_config.get("runtime")
        or "local"
    ).strip().lower()

    resolved_strategy = str(
        strategy
        or active_config.get("deployment_strategy")
        or active_config.get("strategy")
        or "direct"
    ).strip().lower()

    if _prompt_requests_bluegreen(prompt):
        resolved_strategy = "bluegreen"

    if _prompt_requests_direct(prompt):
        resolved_strategy = "direct"

    if resolved_strategy in {
        "blue_green",
        "blue-green",
        "zero_downtime",
        "zero-downtime",
    }:
        resolved_strategy = "bluegreen"

    return resolved_runtime, resolved_strategy


