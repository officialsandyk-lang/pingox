def _start_local_gateway(project_dir: Path, config: dict[str, Any], stop_existing: bool) -> dict[str, Any]:
    port = _config_port(config)

    run_local_gateway = _get_callable(
        "agents.runtime_agent",
        ["run_local_gateway"],
    )

    if run_local_gateway is not None:
        try:
            result = run_local_gateway(
                project_dir=project_dir,
                port=port,
                startup_timeout_seconds=90,
                stop_existing=stop_existing,
            )
        except TypeError:
            result = run_local_gateway(project_dir, port)

        if isinstance(result, dict):
            ok = bool(result.get("success") or result.get("ok") or result.get("runtime_ok"))

            if not ok:
                raise RuntimeError(result.get("error") or result.get("message") or result)

            return result

        if result:
            return {
                "success": True,
                "live_url": _live_url_for_config(config),
            }

    if stop_existing:
        _kill_gateway_port(port)

    runtime_dir = project_dir / ".runtime"
    log_dir = project_dir / "tmp" / "logs"
    runtime_dir.mkdir(parents=True, exist_ok=True)
    log_dir.mkdir(parents=True, exist_ok=True)

    log_file = log_dir / f"local-pingora-{port}.log"

    with log_file.open("a", encoding="utf-8", errors="replace") as log:
        process = subprocess.Popen(
            ["cargo", "run"],
            cwd=str(project_dir),
            stdin=subprocess.DEVNULL,
            stdout=log,
            stderr=log,
            text=True,
            start_new_session=True,
        )

    (runtime_dir / f"local-pingora-{port}.pid").write_text(str(process.pid), encoding="utf-8")

    deadline = time.time() + 90

    while time.time() < deadline:
        if process.poll() is not None:
            tail = log_file.read_text(encoding="utf-8", errors="replace")[-4000:]
            raise RuntimeError(f"Local gateway exited before ready.\n{tail}")

        status = _run_command(
            [
                "bash",
                "-lc",
                f"curl -s -o /dev/null -w '%{{http_code}}' http://127.0.0.1:{port}/",
            ],
            cwd=PROJECT_ROOT,
            timeout=5,
        ).stdout.strip()

        if status in {"200", "301", "302", "403", "404", "405"}:
            return {
                "success": True,
                "pid": process.pid,
                "live_url": _live_url_for_config(config),
                "status": status,
            }

        time.sleep(1)

    raise RuntimeError("Local gateway did not become ready after update.")


def _backup_current_project() -> Path | None:
    if not GENERATED_PROJECT_DIR.exists():
        return None

    backup_root = PROJECT_ROOT / "data" / "update_backups"
    backup_root.mkdir(parents=True, exist_ok=True)

    backup_path = backup_root / f"generated-pingora-proxy-{_utc_now_slug()}"

    if backup_path.exists():
        shutil.rmtree(backup_path)

    shutil.copytree(
        GENERATED_PROJECT_DIR,
        backup_path,
        ignore=shutil.ignore_patterns(
            "target",
            ".runtime",
            "tmp",
            "*.log",
            "__pycache__",
        ),
    )

    return backup_path


def _copy_project_tree(src: Path, dst: Path) -> None:
    if src.resolve() == dst.resolve():
        raise RuntimeError(
            "Refusing to copy project tree onto itself. "
            "Update build_dir must be staging, not generated-pingora-proxy."
        )

    dst.mkdir(parents=True, exist_ok=True)

    for item in list(dst.iterdir()):
        if item.name in {"target", ".runtime"}:
            continue

        if item.is_dir():
            shutil.rmtree(item)
        else:
            item.unlink(missing_ok=True)

    for item in src.iterdir():
        if item.name in {"target", ".runtime"}:
            continue

        target = dst / item.name

        if item.is_dir():
            shutil.copytree(item, target)
        else:
            shutil.copy2(item, target)


def _smoke_test_live(config: dict[str, Any]) -> bool:
    port = _config_port(config)
    routes = config.get("routes") or []

    if not isinstance(routes, list):
        return False

    ok = True

    for route in routes:
        if not isinstance(route, dict):
            continue

        path = _normalize_path(route.get("path") or "/")
        url_path = path if path.endswith("/") else path + "/"
        url = f"http://127.0.0.1:{port}{url_path}"

        result = _run_command(
            [
                "bash",
                "-lc",
                f"curl -s -o /tmp/update_graph_smoke_body.txt -w '%{{http_code}}' {url}",
            ],
            cwd=PROJECT_ROOT,
            timeout=10,
        )

        status = result.stdout.strip()

        route_ok = status in {"200", "301", "302", "403", "404", "405"}

        if not _is_static_route(route):
            route_ok = status == "200"

        print(f"{'✅' if route_ok else '❌'} {path} -> HTTP {status}")

        if not route_ok:
            ok = False

    return ok


@traceable(name="update_local_direct_deploy", run_type="chain")
def run_local_direct_deploy(
    *,
    config: dict[str, Any],
    project_dir: Path,
    run_id: str | None = None,
) -> dict[str, Any]:
    reliability = ReliabilityBrain()
    port = _config_port(config)

    reliability.record_deployment_event(
        run_id=run_id,
        event_type="update_local_direct_deploy",
        status="started",
        color="local",
        details={
            "port": port,
            "route_count": len(config.get("routes", [])),
        },
    )

    backup_path = _backup_current_project()

    print("💾 Creating local backup before promotion...")
    backup_path = create_project_backup(
        GENERATED_PROJECT_DIR,
        reason="local_direct_update_before_promotion",
    )
    print(f"✅ Backup created: {backup_path}")

    print("📦 Promoting staged project to live project folder...")
    _copy_project_tree(project_dir, GENERATED_PROJECT_DIR)

    # Lock the same config into every local config source BEFORE restart.
    # This prevents the local runtime from starting with stale active_config.json
    # while generated-pingora-proxy/config.json has the new routes.
    _write_json(GENERATED_PROJECT_DIR / "config.json", config)
    _save_latest_config(config, "local")

    print("🚀 Starting demo backend ports...")
    _start_demo_backends(GENERATED_PROJECT_DIR / "config.json")

    print("🔁 Restarting local gateway at final step.")
    print("⚠️ Local direct same-port update has a short restart window.")
    _kill_gateway_port(port)
    gateway_result = _start_local_gateway(
        GENERATED_PROJECT_DIR,
        config,
        stop_existing=False,
    )

    print("🧪 Smoke testing updated live URL...")
    smoke_ok = _smoke_test_live(config)

    result = {
        "success": smoke_ok,
        "deployed": smoke_ok,
        "update_mode": "local_direct_staged",
        "active_color": "local",
        "live_url": _live_url_for_config(config),
        "restart_performed": True,
        "backup": str(backup_path) if backup_path else None,
        "gateway": gateway_result,
    }

    reliability.record_deployment_event(
        run_id=run_id,
        event_type="update_local_direct_deploy",
        status="success" if smoke_ok else "failed",
        color="local",
        details=result,
    )

    if not smoke_ok:
        raise RuntimeError("Local direct update promoted, but smoke test failed.")

    return result


