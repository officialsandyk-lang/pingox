ROUTE_MUTATION_CONFIRMATION_PHRASES = {
    "confirm route mutation",
    "confirm route delete",
    "confirm route deletion",
    "confirm route edit",
    "confirm algorithm change",
    "yes delete route",
    "yes edit route",
    "i understand this will delete",
    "i understand this will change",
}


def _route_mutation_confirmation_present(prompt: str) -> bool:
    lower = (prompt or "").lower()
    return any(phrase in lower for phrase in ROUTE_MUTATION_CONFIRMATION_PHRASES)


def _fallback_normalize_upstream(value: Any) -> str:
    text = str(value or "").strip()
    text = text.replace("http://", "").replace("https://", "").rstrip("/")

    if "/" in text:
        text = text.split("/", 1)[0]

    if ":" not in text:
        return f"127.0.0.1:{text}"

    host, port = text.rsplit(":", 1)

    if host == "localhost":
        host = "127.0.0.1"

    return f"{host}:{port}"


def _fallback_algorithm_from_text(text: str) -> str | None:
    lower = text.lower()

    if "weighted round robin" in lower or "weighted_round_robin" in lower:
        return "weighted_round_robin"

    if "least connections" in lower or "least_connections" in lower:
        return "least_connections"

    if "ip hash" in lower or "ip_hash" in lower or "sticky" in lower:
        return "ip_hash"

    if "random" in lower:
        return "random"

    if "round robin" in lower or "round_robin" in lower:
        return "round_robin"

    return None


def _fallback_extract_upstreams(text: str) -> list[str]:
    token_re = (
        r"(?:(?:localhost|127\.0\.0\.1|0\.0\.0\.0|host\.docker\.internal|[A-Za-z0-9_.-]+):\d{2,5}"
        r"|\b\d{2,5}\b)"
    )

    found: list[str] = []

    for token in re.findall(token_re, text or "", flags=re.IGNORECASE):
        address = _fallback_normalize_upstream(token)

        if address not in found:
            found.append(address)

    return found


def _fallback_weight_for_address(clause: str, address: str) -> int:
    port = address.rsplit(":", 1)[-1]

    patterns = [
        rf"{re.escape(address)}\s+weight\s+(?P<weight>\d+)",
        rf"\b{re.escape(port)}\b\s+weight\s+(?P<weight>\d+)",
    ]

    for pattern in patterns:
        match = re.search(pattern, clause, flags=re.IGNORECASE)

        if match:
            try:
                return max(int(match.group("weight")), 1)
            except Exception:
                return 1

    return 1


def _fallback_parse_add_routes(prompt: str) -> list[dict[str, Any]]:
    routes: list[dict[str, Any]] = []

    for raw_clause in re.split(r";|\n", prompt or ""):
        clause = raw_clause.strip()

        if not clause:
            continue

        lower = clause.lower()

        if not re.search(r"\b(add|create|route|load\s+balance|balance)\b", lower):
            continue

        if re.search(r"\b(delete|remove|drop)\b", lower):
            continue

        if re.search(r"\bset\s+rate\b|\brate\s+limit\b", lower) and "/" not in clause:
            continue

        path_match = re.search(r"(?P<path>/[A-Za-z0-9_.\-/]+)", clause)

        if not path_match:
            continue

        path = _normalize_path(path_match.group("path"))

        if path == "/":
            continue

        upstreams = _fallback_extract_upstreams(clause)

        if not upstreams:
            continue

        algorithm = _fallback_algorithm_from_text(clause)

        route: dict[str, Any] = {
            "path": path,
            "upstream": upstreams[0],
            "backend": upstreams[0],
        }

        if len(upstreams) > 1:
            route["balancing"] = algorithm or "round_robin"

            if route["balancing"] == "weighted_round_robin":
                route["upstreams"] = [
                    {
                        "address": address,
                        "weight": _fallback_weight_for_address(clause, address),
                    }
                    for address in upstreams
                ]
            else:
                route["upstreams"] = upstreams

        elif algorithm:
            route["balancing"] = algorithm

        routes.append(route)

    return routes


def _fallback_parse_delete_routes(prompt: str) -> list[str]:
    paths: list[str] = []

    for raw_clause in re.split(r";|\n", prompt or ""):
        clause = raw_clause.strip()

        if not clause:
            continue

        lower = clause.lower()

        if not re.search(r"\b(delete|remove|drop)\b", lower):
            continue

        path_match = re.search(r"(?P<path>/[A-Za-z0-9_.\-/]+)", clause)

        if not path_match:
            continue

        path = _normalize_path(path_match.group("path"))

        if path == "/":
            continue

        if path not in paths:
            paths.append(path)

    return paths


def _fallback_parse_algorithm_edits(prompt: str) -> dict[str, str]:
    edits: dict[str, str] = {}

    for raw_clause in re.split(r";|\n", prompt or ""):
        clause = raw_clause.strip()

        if not clause:
            continue

        lower = clause.lower()

        if not re.search(r"\b(change|update|set|modify)\b", lower):
            continue

        path_match = re.search(r"(?P<path>/[A-Za-z0-9_.\-/]+)", clause)

        if not path_match:
            continue

        path = _normalize_path(path_match.group("path"))

        if path == "/":
            continue

        algorithm = _fallback_algorithm_from_text(clause)

        if algorithm:
            edits[path] = algorithm

    return edits


def _fallback_route_map(routes: Any) -> tuple[dict[str, dict[str, Any]], list[str]]:
    by_path: dict[str, dict[str, Any]] = {}
    order: list[str] = []

    if not isinstance(routes, list):
        return by_path, order

    for route in routes:
        if not isinstance(route, dict):
            continue

        path = _normalize_path(route.get("path") or "/")

        if path not in order:
            order.append(path)

        by_path[path] = route

    return by_path, order


def _fallback_to_string_upstreams(upstreams: Any) -> list[str]:
    output: list[str] = []

    if not isinstance(upstreams, list):
        return output

    for item in upstreams:
        if isinstance(item, dict):
            address = item.get("address") or item.get("upstream")

            if address:
                address = _fallback_normalize_upstream(address)

                if address not in output:
                    output.append(address)

        elif isinstance(item, str):
            address = _fallback_normalize_upstream(item)

            if address not in output:
                output.append(address)

    return output


def _fallback_to_weighted_upstreams(upstreams: Any) -> list[dict[str, Any]]:
    output: list[dict[str, Any]] = []

    if not isinstance(upstreams, list):
        return output

    for item in upstreams:
        if isinstance(item, dict):
            address = item.get("address") or item.get("upstream")

            if not address:
                continue

            try:
                weight = int(item.get("weight", 1))
            except Exception:
                weight = 1

            output.append(
                {
                    "address": _fallback_normalize_upstream(address),
                    "weight": max(weight, 1),
                }
            )

        elif isinstance(item, str):
            output.append(
                {
                    "address": _fallback_normalize_upstream(item),
                    "weight": 1,
                }
            )

    return output


def _detect_dangerous_route_mutations(
    active_config: dict[str, Any],
    prompt: str,
) -> list[dict[str, Any]]:
    routes = active_config.get("routes") or []
    by_path, _ = _fallback_route_map(routes)

    warnings: list[dict[str, Any]] = []

    for path in _fallback_parse_delete_routes(prompt):
        if path in by_path:
            warnings.append(
                {
                    "type": "delete_route",
                    "path": path,
                    "message": (
                        f"WARNING: You are about to delete route {path}. "
                        "This will remove it from config, remove it from the homepage route directory, "
                        "and the live URL will stop serving that route after deployment."
                    ),
                }
            )

    for path, algorithm in _fallback_parse_algorithm_edits(prompt).items():
        if path in by_path:
            current_algorithm = by_path[path].get("balancing")
            warnings.append(
                {
                    "type": "edit_route_algorithm",
                    "path": path,
                    "current_algorithm": current_algorithm,
                    "new_algorithm": algorithm,
                    "message": (
                        f"WARNING: You are about to change route {path} from "
                        f"{current_algorithm or 'single_backend'} to {algorithm}. "
                        "This can change live traffic distribution for that route after deployment."
                    ),
                }
            )

    for route in _fallback_parse_add_routes(prompt):
        path = _normalize_path(route.get("path"))

        if path in by_path:
            warnings.append(
                {
                    "type": "replace_existing_route",
                    "path": path,
                    "message": (
                        f"WARNING: You are about to replace existing route {path}. "
                        "This can change its upstreams, algorithm, weights, and live traffic behaviour."
                    ),
                }
            )

    return warnings


def _build_route_mutation_warning_response(
    active_config: dict[str, Any],
    warnings: list[dict[str, Any]],
    live_url: str,
    run_id: str | None = None,
) -> dict[str, Any]:
    warning_lines = [
        "⚠️ ROUTE UPDATE WARNING",
        "",
        "No changes were deployed.",
        "",
        "The request includes delete/edit operations that can affect live traffic:",
        "",
    ]

    for item in warnings:
        warning_lines.append(f"- {item['message']}")

    warning_lines.extend(
        [
            "",
            "To continue, re-run the update with explicit confirmation.",
            "",
            "Option 1:",
            "  run_update_graph(prompt, confirm_route_mutation=True)",
            "",
            "Option 2:",
            '  Add this phrase to the prompt: "CONFIRM ROUTE MUTATION"',
            "",
            "Recommended before continuing:",
            "  cp generated-pingora-proxy/config.json data/stable_snapshots/before_route_mutation.json",
        ]
    )

    return {
        "success": False,
        "deployed": False,
        "skipped_deploy": True,
        "requires_confirmation": True,
        "warning": "\n".join(warning_lines),
        "planned_route_mutations": warnings,
        "live_url": live_url,
        "config": active_config,
        "run_id": run_id,
    }


def _apply_prompt_route_mutations(
    base_config: dict[str, Any],
    prompt: str,
) -> tuple[dict[str, Any], list[str]]:
    fixed = deepcopy(base_config)
    routes = fixed.get("routes") or []

    if not isinstance(routes, list):
        routes = []

    by_path, order = _fallback_route_map(routes)
    changes: list[str] = []

    for route in _fallback_parse_add_routes(prompt):
        path = _normalize_path(route.get("path"))

        if path not in by_path:
            order.append(path)
            changes.append(f"Added route {path}")
        else:
            changes.append(f"Updated route {path}")

        by_path[path] = route

    edits = _fallback_parse_algorithm_edits(prompt)

    for path, algorithm in edits.items():
        if path not in by_path:
            continue

        route = by_path[path]
        old_algorithm = route.get("balancing")

        if old_algorithm == algorithm:
            continue

        route["balancing"] = algorithm

        if algorithm == "weighted_round_robin":
            route["upstreams"] = _fallback_to_weighted_upstreams(route.get("upstreams"))

            if not route["upstreams"]:
                address = route.get("upstream") or route.get("backend")

                if address:
                    route["upstreams"] = [
                        {
                            "address": _fallback_normalize_upstream(address),
                            "weight": 1,
                        }
                    ]
        else:
            if route.get("upstreams"):
                route["upstreams"] = _fallback_to_string_upstreams(route.get("upstreams"))

        changes.append(f"Updated route {path} algorithm to {algorithm}")

    delete_paths = set(_fallback_parse_delete_routes(prompt))

    for path in list(delete_paths):
        if path not in by_path:
            continue

        by_path.pop(path, None)

        if path in order:
            order.remove(path)

        changes.append(f"Deleted route {path}")

    if not changes:
        return base_config, []

    fixed["routes"] = [by_path[path] for path in order if path in by_path]
    return fixed, changes



# ---------------------------------------------------------------------
# Route mutation parser safety overrides
# ---------------------------------------------------------------------


def _clause_without_route_paths(text: str) -> str:
    """
    Remove route path tokens before checking action words.

    This prevents route names like /tmp-delete, /tmp-remove,
    /delete-me, /remove-test, or /edit-test from being interpreted
    as delete/remove/edit commands.
    """
    return re.sub(r"/[A-Za-z0-9_.\-/]+", " ", text or "")


def _fallback_parse_add_routes(prompt: str) -> list[dict[str, Any]]:
    routes: list[dict[str, Any]] = []

    for raw_clause in re.split(r";|\n", prompt or ""):
        clause = raw_clause.strip()

        if not clause:
            continue

        lower = clause.lower()
        command_text = _clause_without_route_paths(lower)

        # Add intent must be outside the route path itself.
        if not re.search(r"\b(add|create|route|load\s+balance|balance|balanced)\b", command_text):
            continue

        # Do not mistake /tmp-delete or /tmp-remove as delete/remove commands.
        if re.search(r"\b(delete|remove|drop)\b", command_text):
            continue

        if re.search(r"\bset\s+rate\b|\brate\s+limit\b", command_text) and "/" not in clause:
            continue

        path_match = re.search(r"(?P<path>/[A-Za-z0-9_.\-/]+)", clause)

        if not path_match:
            continue

        path = _normalize_path(path_match.group("path"))

        if path == "/":
            continue

        upstreams = _fallback_extract_upstreams(clause)

        if not upstreams:
            continue

        algorithm = _fallback_algorithm_from_text(clause)

        route: dict[str, Any] = {
            "path": path,
            "upstream": upstreams[0],
            "backend": upstreams[0],
        }

        if len(upstreams) > 1:
            route["balancing"] = algorithm or "round_robin"

            if route["balancing"] == "weighted_round_robin":
                route["upstreams"] = [
                    {
                        "address": address,
                        "weight": _fallback_weight_for_address(clause, address),
                    }
                    for address in upstreams
                ]
            else:
                route["upstreams"] = upstreams

        elif algorithm:
            route["balancing"] = algorithm

        routes.append(route)

    return routes


def _fallback_parse_delete_routes(prompt: str) -> list[str]:
    paths: list[str] = []

    for raw_clause in re.split(r";|\n", prompt or ""):
        clause = raw_clause.strip()

        if not clause:
            continue

        lower = clause.lower()
        command_text = _clause_without_route_paths(lower)

        # Delete intent must be outside the route path itself.
        if not re.search(r"\b(delete|remove|drop)\b", command_text):
            continue

        path_match = re.search(r"(?P<path>/[A-Za-z0-9_.\-/]+)", clause)

        if not path_match:
            continue

        path = _normalize_path(path_match.group("path"))

        # Protect homepage/static root.
        if path == "/":
            continue

        if path not in paths:
            paths.append(path)

    return paths


def _fallback_parse_algorithm_edits(prompt: str) -> dict[str, str]:
    edits: dict[str, str] = {}

    for raw_clause in re.split(r";|\n", prompt or ""):
        clause = raw_clause.strip()

        if not clause:
            continue

        lower = clause.lower()
        command_text = _clause_without_route_paths(lower)

        # Edit intent must be outside the route path itself.
        if not re.search(r"\b(change|update|set|modify)\b", command_text):
            continue

        path_match = re.search(r"(?P<path>/[A-Za-z0-9_.\-/]+)", clause)

        if not path_match:
            continue

        path = _normalize_path(path_match.group("path"))

        if path == "/":
            continue

        algorithm = _fallback_algorithm_from_text(clause)

        if algorithm:
            edits[path] = algorithm

    return edits


