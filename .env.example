# AI control plane only; never put this file in the gateway container.
OPENAI_API_KEY=
# Existing compatible model retained; configure task-specific models after evaluation.
OPENAI_MODEL=gpt-4.1-mini
AI_WORKER_BACKEND=responses
AI_CONFIG_MODEL=
# Set to codex to use the installed Codex CLI for repair proposals.
AI_REPAIR_BACKEND=responses
AI_REPAIR_MODEL=
AI_WORKER_TIMEOUT_SECONDS=90
CODEX_BINARY=codex
CODEX_WORKER_MODEL=

# Off by default: prompts/configuration can contain private infrastructure details.
LANGSMITH_TRACING=false
LANGSMITH_PROJECT=ai-pingora-generator
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_API_KEY=
