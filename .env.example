OPENAI_API_KEY=replace_me_on_server_only
PINGORA_AI_API_TOKEN=replace_me
PINGORA_EDGE_API_KEY=replace_me

# -------------------------------
# LLM provider modes
# -------------------------------
# Options:
#   hosted = use pingora-ai FastAPI planner
#   openai = use user's local OpenAI API key
#   ollama = use local/private Ollama
#   none   = disable natural-language planning; use config-file/structured commands
PINGORA_AI_LLM_PROVIDER=hosted

# Hosted planner mode
PINGORA_AI_API_BASE_URL=http://127.0.0.1:8000
PINGORA_AI_API_TOKEN=replace_me

# OpenAI on-demand mode
OPENAI_API_KEY=replace_me_on_server_only
PINGORA_AI_OPENAI_MODEL=gpt-4o-mini

# Ollama private local mode
PINGORA_AI_OLLAMA_BASE_URL=http://127.0.0.1:11434
PINGORA_AI_OLLAMA_MODEL=llama3.1:8b
